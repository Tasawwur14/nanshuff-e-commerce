# ====================================
# Nanshhuf.com Environment Configuration
# ====================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# ====================================
# SERVER CONFIGURATION
# ====================================
# Port the server will run on
PORT=3000

# Node environment (development, production, staging)
NODE_ENV=production

# ====================================
# DATABASE CONFIGURATION
# ====================================
# Your hosting provider's database URL
# Examples:
# - MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
# - cPanel MongoDB: mongodb://username:password@localhost:27017/dbname
# - Hostinger MongoDB: mongodb://username:password@hostname:port/dbname
DATABASE_URL=mongodb://your-database-url-here

# Alternative: MONGO_URI (if DATABASE_URL is not set, this will be used)
MONGO_URI=mongodb://your-database-url-here

# ====================================
# SECURITY & AUTHENTICATION
# ====================================
# Secret key for JWT tokens (use a strong random string)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-very-strong-jwt-secret-key-here

# Secret key for sessions (use a different strong random string)
SESSION_SECRET=your-very-strong-session-secret-key-here

# ====================================
# CORS CONFIGURATION
# ====================================
# Allowed origins for CORS (comma-separated list)
# Use * for all origins (not recommended in production)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=*

# ====================================
# EMAIL CONFIGURATION (Optional)
# ====================================
# For sending emails (transactional emails, notifications, etc.)
# If you're using your hosting provider's email service:
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_SECURE=true

# ====================================
# ADMIN CONFIGURATION
# ====================================
# Default admin credentials (change these immediately!)
ADMIN_EMAIL=admin@nanshhuf.com
ADMIN_PASSWORD=change-this-password

# ====================================
# FILE UPLOAD CONFIGURATION
# ====================================
# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Storage path (relative to server directory)
STORAGE_PATH=./storage

# ====================================
# PAYMENT GATEWAY (Optional)
# ====================================
# If you're using a payment gateway, add credentials here
PAYMENT_GATEWAY_KEY=your-payment-gateway-key
PAYMENT_GATEWAY_SECRET=your-payment-gateway-secret

# ====================================
# LOGGING & MONITORING (Optional)
# ====================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ====================================
# NOTES FOR HOSTING PROVIDER SETUP
# ====================================
# 1. Most hosting providers (cPanel, Hostinger, etc.) provide:
#    - Database hostname (usually localhost or a specific hostname)
#    - Database username and password
#    - Database port (default MongoDB port is 27017)
#
# 2. For cPanel hosting:
#    - Go to "MySQL Databases" or "MongoDB Databases"
#    - Create a new database and user
#    - Note the connection details
#    - Use format: mongodb://username:password@localhost:27017/database_name
#
# 3. For shared hosting without MongoDB:
#    - You may need to use MongoDB Atlas (free tier available)
#    - Create cluster at mongodb.com/cloud/atlas
#    - Get connection string and paste in DATABASE_URL
#
# 4. File permissions:
#    - Ensure the storage directory has write permissions (755 or 775)
#    - Path: server/storage/
#
# 5. Node.js version:
#    - Ensure your hosting supports Node.js 14 or higher
#    - Check with: node --version
