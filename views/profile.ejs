<%- include('partials/header') -%>

<div class="pt-40 max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-serif text-center mb-8">My Profile</h1>
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex flex-col md:flex-row items-center mb-6">
            <div class="bg-gray-200 border-2 border-dashed rounded-xl w-16 h-16 md:w-24 md:h-24 flex items-center justify-center text-gray-500 mb-4 md:mb-0 md:mr-6">
                <i data-lucide="user" class="w-8 h-8"></i>
            </div>
            <div class="text-center md:text-left">
                <h2 class="text-xl font-semibold" id="profile-fullname">Loading...</h2>
                <p class="text-gray-600" id="profile-email">Loading...</p>
            </div>
        </div>
        
        <form id="profile-form">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="text-lg font-semibold mb-3">Personal Information</h3>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm text-gray-600">Full Name</label>
                            <p class="font-medium" id="profile-name">Loading...</p>
                            <input type="text" id="edit-fullname" name="fullName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-accent-brown hidden" value="" />
                        </div>
                        <div>
                            <label class="block text-sm text-gray-600">Email</label>
                            <p class="font-medium" id="profile-email-display">Loading...</p>
                        </div>
                        <div>
                            <label class="block text-sm text-gray-600">Phone</label>
                            <p class="font-medium" id="profile-phone">Loading...</p>
                            <input type="tel" id="edit-phone" name="phone" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-accent-brown hidden" value="" />
                        </div>
                    </div>
                </div>
                
                <div>
                    <h3 class="text-lg font-semibold mb-3">Shipping Address</h3>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm text-gray-600">Address</label>
                            <p class="font-medium" id="profile-address">Loading...</p>
                            <textarea id="edit-address" name="address" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-accent-brown hidden" rows="3"></textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-sm text-gray-600">City</label>
                                <p class="font-medium" id="profile-city">Loading...</p>
                                <input type="text" id="edit-city" name="city" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-accent-brown hidden" value="" />
                            </div>
                            <div>
                                <label class="block text-sm text-gray-600">State</label>
                                <p class="font-medium" id="profile-state">Loading...</p>
                                <input type="text" id="edit-state" name="state" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-accent-brown hidden" value="" />
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-sm text-gray-600">Postal Code</label>
                                <p class="font-medium" id="profile-postalCode">Loading...</p>
                                <input type="text" id="edit-postalCode" name="postalCode" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-accent-brown hidden" value="" />
                            </div>
                            <div>
                                <label class="block text-sm text-gray-600">Country</label>
                                <p class="font-medium" id="profile-country">Loading...</p>
                                <input type="text" id="edit-country" name="country" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-accent-brown hidden" value="" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mt-6">
                <h3 class="text-lg font-semibold mb-3">Account Settings</h3>
                <div class="space-y-3">
                    <button type="button" id="edit-profile-btn" class="w-full py-2 px-4 rounded-md text-white bg-gradient-to-r from-[#8C6A5D] to-[#73564B] hover:from-[#73564B] hover:to-[#8C6A5D] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] transition-colors shadow-sm font-medium">
                        Edit Profile
                    </button>
                    <button type="button" id="save-profile-btn" class="w-full py-2 px-4 rounded-md text-white bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-600 transition-colors shadow-sm font-medium hidden">
                        Save Profile
                    </button>
                    <button type="button" id="cancel-edit-btn" class="w-full py-2 px-4 rounded-md text-white bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors shadow-sm font-medium hidden">
                        Cancel
                    </button>
                    <button type="button" class="w-full py-2 px-4 rounded-md text-white bg-gradient-to-r from-[#8C6A5D] to-[#73564B] hover:from-[#73564B] hover:to-[#8C6A5D] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] transition-colors shadow-sm font-medium">
                        Send Password Reset Link!
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    // Load profile data when the page loads
    document.addEventListener('DOMContentLoaded', async function() {
        try {
            // Use credentials: 'include' to send cookies, no localStorage
            const response = await fetch('/api/auth/profile', {
                credentials: 'include'
            });
            
            if (response.ok) {
                const userData = await response.json();
                document.getElementById('profile-fullname').textContent = userData.fullName || 'Not set';
                document.getElementById('profile-email').textContent = userData.email || 'Not set';
                document.getElementById('profile-name').textContent = userData.fullName || 'Not set';
                document.getElementById('profile-email-display').textContent = userData.email || 'Not set';
                document.getElementById('profile-phone').textContent = userData.phone || 'Not set';
                
                // Populate address fields
                document.getElementById('profile-address').textContent = userData.address || 'Not set';
                document.getElementById('profile-city').textContent = userData.city || 'Not set';
                document.getElementById('profile-state').textContent = userData.state || 'Not set';
                document.getElementById('profile-postalCode').textContent = userData.postalCode || 'Not set';
                document.getElementById('profile-country').textContent = userData.country || 'India';
                
                lucide.createIcons(); // Initialize icons
            } else {
                console.error('Failed to fetch profile data');
                // Redirect to login if profile request fails
                window.location.href = '/login';
            }
        } catch (error) {
            console.error('Error fetching profile:', error);
            window.location.href = '/login';
        }
        
        // Add event listeners for edit and save functionality
        const editBtn = document.getElementById('edit-profile-btn');
        const saveBtn = document.getElementById('save-profile-btn');
        const cancelBtn = document.getElementById('cancel-edit-btn');
        
        editBtn.addEventListener('click', () => {
            enableEdit();
        });
        
        saveBtn.addEventListener('click', () => {
            saveProfile();
        });
        
        cancelBtn.addEventListener('click', () => {
            disableEdit();
        });
    });
    
    // Function to enable edit mode
    function enableEdit() {
        // Show edit inputs and hide static text
        document.getElementById('profile-name').classList.add('hidden');
        document.getElementById('edit-fullname').classList.remove('hidden');
        document.getElementById('edit-fullname').value = document.getElementById('profile-name').textContent;
        
        document.getElementById('profile-phone').classList.add('hidden');
        document.getElementById('edit-phone').classList.remove('hidden');
        document.getElementById('edit-phone').value = document.getElementById('profile-phone').textContent;
        
        document.getElementById('profile-address').classList.add('hidden');
        document.getElementById('edit-address').classList.remove('hidden');
        document.getElementById('edit-address').value = document.getElementById('profile-address').textContent;
        
        document.getElementById('profile-city').classList.add('hidden');
        document.getElementById('edit-city').classList.remove('hidden');
        document.getElementById('edit-city').value = document.getElementById('profile-city').textContent;
        
        document.getElementById('profile-state').classList.add('hidden');
        document.getElementById('edit-state').classList.remove('hidden');
        document.getElementById('edit-state').value = document.getElementById('profile-state').textContent;
        
        document.getElementById('profile-postalCode').classList.add('hidden');
        document.getElementById('edit-postalCode').classList.remove('hidden');
        document.getElementById('edit-postalCode').value = document.getElementById('profile-postalCode').textContent;
        
        document.getElementById('profile-country').classList.add('hidden');
        document.getElementById('edit-country').classList.remove('hidden');
        document.getElementById('edit-country').value = document.getElementById('profile-country').textContent;
        
        // Show save and cancel buttons, hide edit button
        document.getElementById('edit-profile-btn').classList.add('hidden');
        document.getElementById('save-profile-btn').classList.remove('hidden');
        document.getElementById('cancel-edit-btn').classList.remove('hidden');
    }
    
    // Function to disable edit mode - reset to view mode
    function disableEdit() {
        // Show static text and hide edit inputs
        document.getElementById('profile-name').classList.remove('hidden');
        document.getElementById('edit-fullname').classList.add('hidden');
        
        document.getElementById('profile-phone').classList.remove('hidden');
        document.getElementById('edit-phone').classList.add('hidden');
        
        document.getElementById('profile-address').classList.remove('hidden');
        document.getElementById('edit-address').classList.add('hidden');
        
        document.getElementById('profile-city').classList.remove('hidden');
        document.getElementById('edit-city').classList.add('hidden');
        
        document.getElementById('profile-state').classList.remove('hidden');
        document.getElementById('edit-state').classList.add('hidden');
        
        document.getElementById('profile-postalCode').classList.remove('hidden');
        document.getElementById('edit-postalCode').classList.add('hidden');
        
        document.getElementById('profile-country').classList.remove('hidden');
        document.getElementById('edit-country').classList.add('hidden');
        
        // Show edit button, hide save and cancel buttons
        document.getElementById('edit-profile-btn').classList.remove('hidden');
        document.getElementById('save-profile-btn').classList.add('hidden');
        document.getElementById('cancel-edit-btn').classList.add('hidden');
    }
    
    // Function to save profile
    async function saveProfile() {
        // Get updated values
        const updatedData = {
            fullName: document.getElementById('edit-fullname').value.trim(),
            phone: document.getElementById('edit-phone').value.trim(),
            address: document.getElementById('edit-address').value.trim(),
            city: document.getElementById('edit-city').value.trim(),
            state: document.getElementById('edit-state').value.trim(),
            postalCode: document.getElementById('edit-postalCode').value.trim(),
            country: document.getElementById('edit-country').value.trim()
        };
        
        try {
            const response = await fetch('/api/auth/profile', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'include',
                body: JSON.stringify(updatedData)
            });
            
            if (response.ok) {
                const result = await response.json();
                alert(result.message || 'Profile updated successfully!');
                
                // Update the displayed values
                document.getElementById('profile-fullname').textContent = result.user.fullName || 'Not set';
                document.getElementById('profile-name').textContent = result.user.fullName || 'Not set';
                document.getElementById('profile-email-display').textContent = result.user.email || 'Not set';
                document.getElementById('profile-phone').textContent = result.user.phone || 'Not set';
                document.getElementById('profile-address').textContent = result.user.address || 'Not set';
                document.getElementById('profile-city').textContent = result.user.city || 'Not set';
                document.getElementById('profile-state').textContent = result.user.state || 'Not set';
                document.getElementById('profile-postalCode').textContent = result.user.postalCode || 'Not set';
                document.getElementById('profile-country').textContent = result.user.country || 'India';
                
                // Reset to view mode
                disableEdit();
            } else {
                const error = await response.json();
                alert(error.message || 'Failed to update profile');
            }
        } catch (error) {
            console.error('Error updating profile:', error);
            alert('An error occurred while updating your profile');
        }
    }
</script>

<%- include('partials/footer') -%>
