<%- include('partials/header') -%>

    <!-- Main Content -->
    <main>
        <!-- Hero Section -->
        <section class="pt-24 lg:pt-40 bg-bg-card">
            <div class="relative container mx-auto overflow-hidden rounded-xl shadow-2xl h-[30vh] lg:h-[40vh] flex items-center justify-center text-center">
                <img src="/images/contact.png" class="absolute w-full h-full object-cover" alt="Contact Us background with abstract shapes" style="object-position: 50% 70%;">
                <div class="absolute inset-0 bg-black/40"></div>
                <div class="relative text-white p-8" data-aos="zoom-in">
                    <h1 class="font-serif text-4xl md:text-7xl font-bold">Get in Touch</h1>
                    <p class="mt-4 text-lg md:text-xl max-w-2xl mx-auto">We're here to help and answer any question you might have.</p>
                </div>
            </div>
        </section>

        <!-- Contact Form and Details Section -->
        <section class="py-16 lg:py-24">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                    <!-- Contact Details -->
                    <div class="space-y-8" data-aos="fade-right">
                        <div>
                            <h2 class="font-serif text-3xl">Contact Information</h2>
                            <p class="text-text-secondary mt-2">Fill up the form and our team will get back to you within 24 hours.</p>
                        </div>
                        <div class="space-y-6">
                            <div class="flex items-start">
                                <i data-lucide="phone" class="w-6 h-6 text-accent-brown mt-1 flex-shrink-0"></i>
                                <div class="ml-4">
                                    <h4 class="font-semibold">Phone</h4>
                                    <a href="tel:+919167864208" class="text-text-secondary hover:text-accent-brown">+91 9167864208</a><br>
                                    <a href="tel:+917039472723" class="text-text-secondary hover:text-accent-brown">+91 7039472723</a>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <i data-lucide="mail" class="w-6 h-6 text-accent-brown mt-1 flex-shrink-0"></i>
                                <div class="ml-4">
                                    <h4 class="font-semibold">Email</h4>
                                    <a href="mailto:nanshhuf@gmail.com" class="text-text-secondary hover:text-accent-brown">nanshhuf@gmail.com</a>
                                </div>
                            </div>
                             <div class="flex items-start">
                                <i data-lucide="map-pin" class="w-6 h-6 text-accent-brown mt-1 flex-shrink-0"></i>
                                <div class="ml-4">
                                    <h4 class="font-semibold">Address</h4>
                                    <p class="text-text-secondary">Shop Number 5, Building Number 4, Monarch Qureshi bldg, Veera Desai Rd, behind EVERSHINE COSMIC, Veera Desai Industrial Estate, Jogeshwari West, Mumbai, Maharashtra 400102</p>
                                </div>
                            </div>
                        </div>
                         <div>
                            <div class="aspect-w-16 aspect-h-9 rounded-lg overflow-hidden shadow-lg">
                                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d609.6820028916866!2d72.83584448348172!3d19.14121512382495!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7b633f44750f3%3A0x78efa43741dd939d!2sZaib%20Services!5e1!3m2!1sen!2sin!4v1759034600529!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                            </div>
                        </div>
                    </div>

                    <!-- Enquiry Form -->
                    <div class="bg-bg-card p-8 rounded-lg shadow-2xl" data-aos="fade-left">
                        <h2 class="font-serif text-3xl mb-6">Send us a Message</h2>
                        <form action="#" method="POST" class="space-y-6">
                            <div>
                                <label for="name" class="block text-sm font-medium text-text-primary">Full Name</label>
                                <input type="text" id="name" name="name" required class="mt-1 block w-full px-4 py-2 bg-bg-light border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-accent-brown focus:border-accent-brown">
                            </div>
                             <div>
                                <label for="email" class="block text-sm font-medium text-text-primary">Email Address</label>
                                <input type="email" id="email" name="email" required class="mt-1 block w-full px-4 py-2 bg-bg-light border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-accent-brown focus:border-accent-brown">
                            </div>
                             <div>
                                <label for="phone" class="block text-sm font-medium text-text-primary">Phone Number</label>
                                <input type="tel" id="phone" name="phone" class="mt-1 block w-full px-4 py-2 bg-bg-light border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-accent-brown focus:border-accent-brown">
                            </div>
                            <div>
                                <label for="message" class="block text-sm font-medium text-text-primary">Message</label>
                                <textarea id="message" name="message" rows="5" required class="mt-1 block w-full px-4 py-2 bg-bg-light border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-accent-brown focus:border-accent-brown"></textarea>
                            </div>
                            <div>
                                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gradient-to-r from-[#8C6A5D] to-[#73564B] hover:from-[#73564B] hover:to-[#8C6A5D] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] transition-colors">
                                    Send Message
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 800, once: true, offset: 100 });
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>

<%- include('partials/footer') -%>