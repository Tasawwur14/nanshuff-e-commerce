<%- include('partials/header') -%>

    <main>
        <!-- Hero -->
        <section class="pt-24 lg:pt-40 bg-bg-card">
            <div class="relative container mx-auto overflow-hidden rounded-xl shadow-2xl h-[30vh] lg:h-[40vh] flex items-center justify-center text-center">
                <img src="/images/contact.png" class="absolute w-full h-full object-cover" alt="" style="object-position: 50% 70%;">
                <div class="absolute inset-0 bg-black/50"></div>
                <div class="relative text-white p-8" data-aos="zoom-in">
                    <h1 class="font-serif text-4xl md:text-7xl font-bold">Get in Touch</h1>
                    <p class="mt-4 text-lg md:text-xl max-w-2xl mx-auto">Questions about an order, a product or a bulk requirement? We usually reply within 24 hours.</p>
                </div>
            </div>
        </section>

        <!-- Quick contact cards -->
        <section class="pt-12 lg:pt-16">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <a href="tel:+919167864208" class="group bg-bg-card rounded-xl p-6 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex items-center gap-4" data-aos="fade-up">
                        <span class="flex-shrink-0 h-14 w-14 rounded-full bg-accent-brown/10 flex items-center justify-center group-hover:bg-accent-brown transition-colors">
                            <i data-lucide="phone" class="w-6 h-6 text-accent-brown group-hover:text-white transition-colors"></i>
                        </span>
                        <span>
                            <span class="block text-xs uppercase tracking-wider text-text-secondary">Call us</span>
                            <span class="block font-semibold">+91 9167864208</span>
                            <span class="block text-sm text-text-secondary">+91 7039472723</span>
                        </span>
                    </a>
                    <a href="mailto:nanshhuf@gmail.com" class="group bg-bg-card rounded-xl p-6 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex items-center gap-4" data-aos="fade-up" data-aos-delay="100">
                        <span class="flex-shrink-0 h-14 w-14 rounded-full bg-accent-brown/10 flex items-center justify-center group-hover:bg-accent-brown transition-colors">
                            <i data-lucide="mail" class="w-6 h-6 text-accent-brown group-hover:text-white transition-colors"></i>
                        </span>
                        <span class="min-w-0">
                            <span class="block text-xs uppercase tracking-wider text-text-secondary">Email us</span>
                            <span class="block font-semibold break-all">nanshhuf@gmail.com</span>
                            <span class="block text-sm text-text-secondary">Reply within 24 hours</span>
                        </span>
                    </a>
                    <a href="https://www.google.com/maps/search/?api=1&query=Monarch+Qureshi+bldg+Veera+Desai+Rd+Jogeshwari+West+Mumbai+400102" target="_blank" rel="noopener" class="group bg-bg-card rounded-xl p-6 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex items-center gap-4" data-aos="fade-up" data-aos-delay="200">
                        <span class="flex-shrink-0 h-14 w-14 rounded-full bg-accent-brown/10 flex items-center justify-center group-hover:bg-accent-brown transition-colors">
                            <i data-lucide="map-pin" class="w-6 h-6 text-accent-brown group-hover:text-white transition-colors"></i>
                        </span>
                        <span>
                            <span class="block text-xs uppercase tracking-wider text-text-secondary">Visit us</span>
                            <span class="block font-semibold">Jogeshwari West, Mumbai</span>
                            <span class="block text-sm text-text-secondary">Get directions &rarr;</span>
                        </span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Form + map -->
        <section class="py-12 lg:py-20">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">

                    <!-- Form -->
                    <div class="lg:col-span-3 bg-bg-card p-6 md:p-10 rounded-xl shadow-2xl" data-aos="fade-right">
                        <div id="contact-form-wrap">
                            <h2 class="font-serif text-3xl">Send us a message</h2>
                            <p class="text-text-secondary mt-2 mb-8">Tell us how we can help and the right person will get back to you.</p>

                            <form id="contact-form" novalidate class="space-y-6">
                                <!-- Honeypot: hidden from humans, bots fill it -->
                                <div class="absolute -left-[9999px]" aria-hidden="true">
                                    <label for="website">Website</label>
                                    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                                </div>

                                <fieldset>
                                    <legend class="block text-sm font-medium mb-3">What is this about?</legend>
                                    <div class="flex flex-wrap gap-2" id="topic-group" role="radiogroup">
                                        <% [['order','Order support'],['product','Product question'],['bulk','Bulk / wholesale'],['feedback','Feedback'],['other','Other']].forEach(function(t, i){ %>
                                        <label class="cursor-pointer">
                                            <input type="radio" name="topic" value="<%= t[0] %>" class="peer sr-only" <%= i === 0 ? 'checked' : '' %>>
                                            <span class="inline-block px-4 py-2 rounded-full border border-gray-300 text-sm text-text-secondary transition-colors peer-checked:bg-accent-brown peer-checked:border-accent-brown peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-accent-brown peer-focus-visible:ring-offset-2 hover:border-accent-brown"><%= t[1] %></span>
                                        </label>
                                        <% }) %>
                                    </div>
                                </fieldset>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label for="name" class="block text-sm font-medium">Full name <span class="text-red-500">*</span></label>
                                        <input type="text" id="name" name="name" required maxlength="100" autocomplete="name" value="<%= user && user.name ? user.name : '' %>" class="field mt-1 block w-full px-4 py-3 bg-bg-light border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-brown focus:border-accent-brown">
                                        <p class="field-error hidden text-xs text-red-600 mt-1"></p>
                                    </div>
                                    <div>
                                        <label for="phone" class="block text-sm font-medium">Phone <span class="text-text-secondary font-normal">(optional)</span></label>
                                        <input type="tel" id="phone" name="phone" maxlength="20" autocomplete="tel" value="<%= user && user.phone ? user.phone : '' %>" class="field mt-1 block w-full px-4 py-3 bg-bg-light border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-brown focus:border-accent-brown">
                                        <p class="field-error hidden text-xs text-red-600 mt-1"></p>
                                    </div>
                                </div>

                                <div>
                                    <label for="email" class="block text-sm font-medium">Email address <span class="text-red-500">*</span></label>
                                    <input type="email" id="email" name="email" required maxlength="254" autocomplete="email" value="<%= user && user.email ? user.email : '' %>" class="field mt-1 block w-full px-4 py-3 bg-bg-light border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-brown focus:border-accent-brown">
                                    <p class="field-error hidden text-xs text-red-600 mt-1"></p>
                                </div>

                                <div>
                                    <div class="flex justify-between items-baseline">
                                        <label for="message" class="block text-sm font-medium">Message <span class="text-red-500">*</span></label>
                                        <span id="msg-count" class="text-xs text-text-secondary">0 / 2000</span>
                                    </div>
                                    <textarea id="message" name="message" rows="5" required maxlength="2000" class="field mt-1 block w-full px-4 py-3 bg-bg-light border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent-brown focus:border-accent-brown"></textarea>
                                    <p class="field-error hidden text-xs text-red-600 mt-1"></p>
                                </div>

                                <p id="form-error" role="alert" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3"></p>

                                <button type="submit" id="submit-btn" class="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-lg shadow-md text-sm font-semibold text-white bg-gradient-to-r from-[#8C6A5D] to-[#73564B] hover:from-[#73564B] hover:to-[#8C6A5D] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
                                    <span id="submit-label">Send message</span>
                                    <i data-lucide="send" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </div>

                        <!-- Success state -->
                        <div id="contact-success" class="hidden text-center py-12" role="status">
                            <div class="mx-auto h-20 w-20 rounded-full bg-green-100 flex items-center justify-center mb-6">
                                <i data-lucide="check" class="w-10 h-10 text-green-600"></i>
                            </div>
                            <h2 class="font-serif text-3xl">Message sent</h2>
                            <p id="success-text" class="text-text-secondary mt-3 max-w-md mx-auto">Thanks! We will get back to you within 24 hours.</p>
                            <button type="button" id="send-another" class="mt-8 text-accent-brown font-semibold hover:underline">Send another message</button>
                        </div>
                    </div>

                    <!-- Side: map + help links -->
                    <div class="lg:col-span-2 space-y-6" data-aos="fade-left">
                        <div class="rounded-xl overflow-hidden shadow-lg bg-bg-card">
                            <iframe title="Nanshhuf location map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d609.6820028916866!2d72.83584448348172!3d19.14121512382495!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7b633f44750f3%3A0x78efa43741dd939d!2sZaib%20Services!5e1!3m2!1sen!2sin!4v1759034600529!5m2!1sen!2sin" class="w-full h-72 border-0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                            <div class="p-5 flex items-start gap-3">
                                <i data-lucide="map-pin" class="w-5 h-5 text-accent-brown mt-0.5 flex-shrink-0"></i>
                                <p class="text-sm text-text-secondary">Shop No. 5, Building No. 4, Monarch Qureshi Bldg, Veera Desai Rd, behind Evershine Cosmic, Veera Desai Industrial Estate, Jogeshwari West, Mumbai, Maharashtra 400102</p>
                            </div>
                        </div>

                        <div class="bg-bg-card rounded-xl shadow-md p-6">
                            <h3 class="font-serif text-xl mb-4">Looking for something quick?</h3>
                            <ul class="space-y-3 text-sm">
                                <li><a href="/myorders" class="flex items-center justify-between hover:text-accent-brown"><span class="flex items-center gap-3"><i data-lucide="package" class="w-4 h-4 text-accent-brown"></i>Track my order</span><i data-lucide="chevron-right" class="w-4 h-4"></i></a></li>
                                <li><a href="/return" class="flex items-center justify-between hover:text-accent-brown"><span class="flex items-center gap-3"><i data-lucide="rotate-ccw" class="w-4 h-4 text-accent-brown"></i>Returns &amp; refunds</span><i data-lucide="chevron-right" class="w-4 h-4"></i></a></li>
                                <li><a href="/privacy" class="flex items-center justify-between hover:text-accent-brown"><span class="flex items-center gap-3"><i data-lucide="shield-check" class="w-4 h-4 text-accent-brown"></i>Privacy policy</span><i data-lucide="chevron-right" class="w-4 h-4"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 800, once: true, offset: 100 });
    if (typeof lucide !== 'undefined') lucide.createIcons();

    (function () {
        var form = document.getElementById('contact-form');
        var wrap = document.getElementById('contact-form-wrap');
        var success = document.getElementById('contact-success');
        var btn = document.getElementById('submit-btn');
        var label = document.getElementById('submit-label');
        var formError = document.getElementById('form-error');
        var msg = document.getElementById('message');
        var count = document.getElementById('msg-count');

        msg.addEventListener('input', function () { count.textContent = msg.value.length + ' / 2000'; });

        function setError(input, text) {
            var p = input.parentElement.querySelector('.field-error');
            if (!p) return;
            p.textContent = text || '';
            p.classList.toggle('hidden', !text);
            input.classList.toggle('border-red-400', !!text);
            input.setAttribute('aria-invalid', text ? 'true' : 'false');
        }

        // Mirrors server-side rules in controllers/contactController.js
        function validate() {
            var ok = true, first = null;
            function check(id, test, text) {
                var el = document.getElementById(id);
                var bad = test(el.value.trim());
                setError(el, bad ? text : '');
                if (bad) { ok = false; first = first || el; }
            }
            check('name', function (v) { return v.length < 2; }, 'Please enter your name.');
            check('email', function (v) { return !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); }, 'Please enter a valid email address.');
            check('phone', function (v) { return v && !/^[+()\d\s-]{7,20}$/.test(v); }, 'Please enter a valid phone number.');
            check('message', function (v) { return v.length < 10; }, 'Please write at least 10 characters.');
            if (first) first.focus();
            return ok;
        }

        form.querySelectorAll('.field').forEach(function (el) {
            el.addEventListener('input', function () { setError(el, ''); });
        });

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            formError.classList.add('hidden');
            if (!validate()) return;

            btn.disabled = true;
            label.textContent = 'Sending...';
            try {
                var data = Object.fromEntries(new FormData(form).entries());
                var res = await fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                var body = await res.json().catch(function () { return {}; });
                if (!res.ok) throw new Error(body.message || body.error || 'Something went wrong. Please try again.');

                document.getElementById('success-text').textContent = body.message || 'Thanks! We will get back to you within 24 hours.';
                wrap.classList.add('hidden');
                success.classList.remove('hidden');
                success.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (err) {
                formError.textContent = err.message;
                formError.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                label.textContent = 'Send message';
            }
        });

        document.getElementById('send-another').addEventListener('click', function () {
            msg.value = '';
            count.textContent = '0 / 2000';
            success.classList.add('hidden');
            wrap.classList.remove('hidden');
            msg.focus();
        });
    })();
</script>

<%- include('partials/footer') -%>
