<%- include('partials/header') -%>

<main id="main-content">
    <section class="pt-40 pb-16 bg-bg-light">
        <div class="container mx-auto px-4">
        
        <div id="cart-content" class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:items-start">
            
            <div class="lg:col-span-2 space-y-10">
                <div id="cart-items-container" class="space-y-4">
                    <!-- Cart items will be loaded dynamically -->
                </div>

            </div>

            <div class="lg:col-span-1">
                <div class="bg-white p-6 rounded-lg shadow-lg sticky top-28">
                    <h2 class="text-xl font-semibold border-b pb-3 mb-4">Order Summary</h2>
                    
                    <div class="space-y-3 text-text-secondary">
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span id="summary-subtotal">Loading...</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Shipping</span>
                            <span>Calculated at next step</span>
                        </div>
                    </div>
                    
                    <div class="mt-4 pt-4 border-t">
                        <label for="discount-code" class="font-semibold text-sm mb-2 block">Discount Code</label>
                        <div class="flex space-x-2">
                            <input type="text" id="discount-code" placeholder="Enter code" class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-accent-brown">
                            <button id="apply-discount-btn" class="bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-semibold px-4 rounded-md hover:from-[#73564B] hover:to-[#8C6A5D] transition-colors text-sm">Apply</button>
                        </div>
                        <p id="discount-message" class="text-xs mt-2 h-4"></p>
                    </div>

                    <div class="border-t mt-4 pt-4">
                        <div class="flex justify-between font-bold text-lg text-text-primary">
                            <span>Total</span>
                            <span id="summary-total">Loading...</span>
                        </div>
                    </div>
                    
                    <button id="proceed-checkout-btn" class="bg-gradient-to-r from-[#8C6A5D] to-[#73564B] w-full mt-6 text-white font-bold py-3 px-6 rounded-md hover:from-[#73564B] hover:to-[#8C6A5D] transition-colors duration-300">
                        Proceed to Checkout
                    </button>
                </div>
            </div>
        </div>

        <div id="empty-cart-message" class="hidden text-center py-20">
            <i data-lucide="shopping-cart" class="w-20 h-20 mx-auto text-gray-300"></i>
            <h2 class="mt-6 text-2xl font-semibold text-text-primary">Your Cart is Empty</h2>
            <p class="text-text-secondary mt-2">Looks like you haven't added anything to your cart yet.</p>
            <a href="/products" class="mt-10 bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-3 px-8 rounded-md hover:from-[#73564B] hover:to-[#8C6A5D] transition-colors duration-300 inline-block shrink-0">
                Continue Shopping
            </a>
        </div>
        
        <% if (typeof cartItems !== 'undefined' && cartItems && cartItems.length > 0) { %>
        <div id="related-products-section" class="mt-20 pt-10 border-t">
            <h2 class="text-2xl font-serif text-center mb-6">You Might Also Like</h2>
            <div class="related-products-container relative">
                <button id="prev-related-products" class="absolute left-0 top-1/2 transform -translate-y-1/2 z-10 p-3 rounded-full bg-white shadow-lg hover:bg-gray-100 border border-gray-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                </button>
                <div id="related-products-carousel" class="flex overflow-x-hidden space-x-6 pb-4 px-12"> <!-- Added horizontal padding to accommodate buttons -->
                    <% if (typeof relatedProducts !== 'undefined' && relatedProducts && relatedProducts.length > 0) { %>
                        <% relatedProducts.forEach(product => { %>
                            <div class="related-product-card flex-shrink-0 w-64">
                                <div class="bg-white rounded-lg shadow-sm overflow-hidden group relative flex flex-col h-full">
                                    <a href="/product/<%= product.id %>" class="block flex flex-col flex-grow">
                                        <div class="relative overflow-hidden h-40 bg-gray-100">
                                            <% if (product.imageUrl) { %>
                                                <img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                            <% } else { %>
                                                <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                                                    <span class="text-gray-400">No image</span>
                                                </div>
                                            <% } %>
                                            <% if (product.discount && product.discount > 0) { %>
                                                <div class="absolute top-2 left-2 bg-gradient-to-r from-red-500 to-red-600 text-white text-xs font-bold px-2 py-1 rounded z-10">
                                                    <%= product.discount %>% OFF
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="p-3 flex flex-col flex-grow">
                                            <div class="flex-grow">
                                                <h3 class="font-semibold text-sm text-text-primary truncate" title="<%= product.name %>"><%= product.name %></h3>
                                                <div class="flex items-center gap-1 mt-1">
                                                    <p class="text-accent-brown font-bold text-sm whitespace-nowrap">₹<%= Number(product.price).toFixed(2) %></p>
                                                    <% if (product.discount && product.discount > 0 && product.mrp && product.mrp > product.price) { %>
                                                        <p class="text-gray-500 line-through text-xs">₹<%= Number(product.mrp).toFixed(2) %></p>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <div class="mt-2">
                                                <button class="add-to-cart-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white text-xs font-bold px-3 py-1.5 rounded-md hover:from-[#73564B] hover:to-[#8C6A5D] transition-colors w-full" data-id="<%= product.id %>">
                                                    Add to Cart
                                                </button>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-center text-text-secondary w-full">No related products found.</p>
                    <% } %>
                </div>
                <button id="next-related-products" class="absolute right-0 top-1/2 transform -translate-y-1/2 z-10 p-3 rounded-full bg-white shadow-lg hover:bg-gray-100 border border-gray-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        </div>
        <% } %>

    </div>
    </section>
</main>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 800, once: true, offset: 100 });
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
<script src="/assets/js/cart.js"></script>

<%- include('partials/footer') -%>