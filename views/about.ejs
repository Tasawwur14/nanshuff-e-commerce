<%- include('partials/header') -%>

    <!-- Main Content -->
    <main>
        <!-- Hero Section -->
        <section class="pt-24 lg:pt-40 bg-bg-card">
            <div class="relative container mx-auto overflow-hidden rounded-xl shadow-2xl h-[30vh] lg:h-[40vh] flex items-center justify-center text-center">
                <img src="/images/whyfrozen.png" class="absolute w-full h-full object-cover" alt="Gourmet Food Background" style="object-position: 50% 90%;">
                <div class="absolute inset-0 bg-black/40"></div>
                <div class="relative text-white p-8" data-aos="zoom-in">
                    <h1 class="font-serif text-4xl md:text-7xl font-bold">About Nanshhuf</h1>
                    <p class="mt-4 text-lg md:text-xl max-w-2xl mx-auto">Redefining Frozen Luxury, One Bite at a Time.</p>
                </div>
            </div>
        </section>

        <!-- Intro Section -->
        <section class="py-16 lg:py-24">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="max-w-3xl mx-auto text-center">
                    <p class="text-lg text-text-secondary" data-aos="fade-up">
                        At <strong>Nanshhuf</strong>, we believe food isn’t just about taste — it’s about an experience. That’s why we’ve curated a world of <strong>premium frozen delights</strong>, blending global inspiration with uncompromised quality. Every product we create is designed to bring <strong>restaurant-style excellence</strong> straight to your home, without the hassle.
                    </p>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="py-16 lg:py-24 bg-bg-card border-y border-gray-200">
            <div class="container mx-auto px-4 lg:px-6">
                 <div class="max-w-3xl mx-auto text-center mb-12" data-aos="fade-up">
                    <h2 class="text-3xl md:text-5xl font-serif">The Perfect Fit For Your Modern Lifestyle</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <!-- Feature Item -->
                    <div class="text-center p-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="flex items-center justify-center h-16 w-16 rounded-full bg-accent-brown/10 mx-auto mb-4">
                            <i data-lucide="globe-2" class="w-8 h-8 text-accent-brown"></i>
                        </div>
                        <h3 class="font-semibold text-lg mb-2">Global Taste, Local Love</h3>
                        <p class="text-text-secondary text-sm">From timeless classics to global inspirations, every recipe is crafted to satisfy cravings across cultures.</p>
                    </div>
                     <!-- Feature Item -->
                    <div class="text-center p-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-center justify-center h-16 w-16 rounded-full bg-accent-brown/10 mx-auto mb-4">
                            <i data-lucide="snowflake" class="w-8 h-8 text-accent-brown"></i>
                        </div>
                        <h3 class="font-semibold text-lg mb-2">Frozen Freshness, Perfect Flavor</h3>
                        <p class="text-text-secondary text-sm">Our technology locks in the authentic taste, so every bite feels freshly made.</p>
                    </div>
                     <!-- Feature Item -->
                    <div class="text-center p-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="flex items-center justify-center h-16 w-16 rounded-full bg-accent-brown/10 mx-auto mb-4">
                            <i data-lucide="clock" class="w-8 h-8 text-accent-brown"></i>
                        </div>
                        <h3 class="font-semibold text-lg mb-2">Effortless Convenience</h3>
                        <p class="text-text-secondary text-sm">Just heat, cook, or fry — and enjoy gourmet flavors in minutes.</p>
                    </div>
                     <!-- Feature Item -->
                    <div class="text-center p-6" data-aos="fade-up" data-aos-delay="400">
                        <div class="flex items-center justify-center h-16 w-16 rounded-full bg-accent-brown/10 mx-auto mb-4">
                            <i data-lucide="gem" class="w-8 h-8 text-accent-brown"></i>
                        </div>
                        <h3 class="font-semibold text-lg mb-2">Quality First, Always</h3>
                        <p class="text-text-secondary text-sm">We handpick the finest ingredients, ensuring you get nothing short of excellence on your plate.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Promise Section -->
        <section class="py-16 lg:py-24">
             <div class="container mx-auto px-4 lg:px-6">
                 <div class="max-w-3xl mx-auto text-center mb-12" data-aos="fade-up">
                    <h2 class="text-3xl md:text-5xl font-serif">More Than Just Frozen Food</h2>
                    <p class="text-lg text-text-secondary mt-4">We are more than a frozen food brand — we are a <strong>promise of luxury, quality, and trust.</strong></p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                    <!-- Promise Item -->
                    <div class="bg-bg-card p-8 rounded-lg shadow-lg" data-aos="fade-up" data-aos-delay="100">
                        <i data-lucide="heart-handshake" class="w-12 h-12 text-accent-brown mx-auto mb-4"></i>
                        <h3 class="font-semibold text-xl mb-2">Premium Care</h3>
                        <p class="text-text-secondary">Our service matches the quality of our food — warm, reliable, and customer-first.</p>
                    </div>
                     <!-- Promise Item -->
                     <div class="bg-bg-card p-8 rounded-lg shadow-lg" data-aos="fade-up" data-aos-delay="200">
                        <i data-lucide="party-popper" class="w-12 h-12 text-accent-brown mx-auto mb-4"></i>
                        <h3 class="font-semibold text-xl mb-2">Lifestyle Experience</h3>
                        <p class="text-text-secondary">With Nanshhuf, every meal becomes a moment to celebrate, whether it’s a quick snack or a family feast.</p>
                    </div>
                     <!-- Promise Item -->
                     <div class="bg-bg-card p-8 rounded-lg shadow-lg" data-aos="fade-up" data-aos-delay="300">
                        <i data-lucide="shield-check" class="w-12 h-12 text-accent-brown mx-auto mb-4"></i>
                        <h3 class="font-semibold text-xl mb-2">Trusted Brand</h3>
                        <p class="text-text-secondary">Loved nationally and growing globally, Nanshhuf continues to deliver excellence with every pack.</p>
                    </div>
                </div>
             </div>
        </section>

         <!-- CTA Section -->
        <section class="py-16 lg:py-24 bg-bg-card">
            <div class="container mx-auto px-4 lg:px-6 text-center">
                <div data-aos="fade-up">
                    <h2 class="font-serif text-2xl md:text-4xl text-accent-brown">Embrace the Nanshhuf way of taste</h2>
                    <p class="text-lg max-w-2xl mx-auto mt-4 text-text-secondary">Where luxury meets convenience, and every meal feels like a culinary celebration.</p>
                    <p class="mt-8 font-semibold">Discover Nanshhuf Frozen Foods today — because good taste should never wait.</p>
                </div>
            </div>
        </section>
    </main>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 800, once: true, offset: 100 });
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>

<%- include('partials/footer') -%>