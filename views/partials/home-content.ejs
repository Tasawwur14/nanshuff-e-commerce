        <section id="featured" class="py-12 bg-bg-card border-y border-gray-200">
            <div class="container mx-auto px-4">
                <div class="flex flex-col md:flex-row justify-between items-center mb-12" data-aos="fade-up">
                    <div class="text-center md:text-left">
                        <h2 class="text-4xl md:text-6xl font-serif">Featured Collection</h2>
                        <p class="text-text-secondary mt-2">Handpicked selections from our master chefs.</p>
                    </div>
                    <a href="/products" class="mt-10 bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-3 px-8 rounded-md hover:from-[#73564B] hover:to-[#8C6A5D] transition-colors duration-300 inline-block shrink-0c">View All Products</a>
                </div>
                <div id="product-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
                    <% if (typeof featuredProducts !== 'undefined' && featuredProducts && featuredProducts.length > 0) { %>
                        <% featuredProducts.forEach(function(product) { %>
                            <div class="bg-white rounded-lg shadow-md overflow-hidden group relative flex flex-col h-full" data-aos="fade-up">
                                <div class="relative overflow-hidden group">
                                    <img src="<%= product.imageUrl || '/images/placeholder.png' %>" alt="<%= product.name %>" class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500">
                                    <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                </div>
                                <div class="p-6">
                                    <h3 class="text-xl font-semibold mb-2"><%= product.name %></h3>
                                    <p class="text-text-secondary text-sm mb-4"><%= product.short_description ? product.short_description.substring(0, 100) : '' %>...</p>
                                    <div class="flex flex-wrap items-center justify-between">
                                        <div class="flex flex-wrap items-baseline gap-2">
                                            <span class="text-2xl font-bold text-accent-brown">₹<%= Number(product.price).toFixed(2) %></span>
                                            <% if (product.mrp && product.mrp > 0 && product.discount > 0 && product.mrp != product.price) { %>
                                                <span class="text-lg text-gray-500 line-through">₹<%= Number(product.mrp).toFixed(2) %></span>
                                            <% } %>
                                            <% if (product.discount > 0) { %>
                                                <span class="text-sm font-semibold text-green-600 bg-green-100 px-2 py-1 rounded">(<%= product.discount %>% off)</span>
                                            <% } %>
                                        </div>
                                        <a href="/product/<%= product.id %>" class="bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white px-4 py-2 rounded-md hover:from-[#73564B] hover:to-[#8C6A5D] transition-colors">View Details</a>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </section>
