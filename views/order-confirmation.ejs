<%- include('partials/header') -%>

<section class="pt-40 pb-16 bg-bg-light">
    <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center">
            <!-- Success Message -->
            <div class="mb-8">
                <div class="inline-block mb-4">
                    <svg class="w-16 h-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h1 class="text-3xl font-bold text-green-600 mb-2">Order Confirmed!</h1>
                <p class="text-gray-600 mb-4">Thank you for your purchase. Your order has been successfully placed.</p>
                <p class="text-gray-600">You will receive an order confirmation email shortly with all the details.</p>
            </div>
            
            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/myorders" 
                    class="px-6 py-3 rounded-lg font-semibold text-white 
                            bg-gradient-to-r from-[#8C6A5D] to-[#73564B] 
                            hover:from-[#73564B] hover:to-[#8C6A5D] 
                            focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] 
                            transition-colors shadow-sm">
                    View My Orders
                    </a>

                <a  href="/products" 
                    class="px-6 py-3 rounded-lg font-semibold text-white 
                            bg-gradient-to-r from-[#8C6A5D] to-[#73564B] 
                            hover:from-[#73564B] hover:to-[#8C6A5D] 
                            focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] 
                            transition-colors shadow-sm">
                    Continue Shopping
                    </a>

                <a href="/index" 
                    class="px-6 py-3 rounded-lg font-semibold text-white 
                            bg-gradient-to-r from-[#8C6A5D] to-[#73564B] 
                            hover:from-[#73564B] hover:to-[#8C6A5D] 
                            focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] 
                            transition-colors shadow-sm">
                    Back to Home
                </a>

            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') -%>
