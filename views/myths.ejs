<%- include('partials/header') -%>

    <!-- Main Content -->
    <main>
        <!-- Hero Section -->
        <section class="pt-24 lg:pt-40 bg-bg-card">
            <div class="relative container mx-auto overflow-hidden rounded-xl shadow-2xl h-[30vh] lg:h-[40vh] flex items-center justify-center text-center">
                <img src="/images/myths.png" class="absolute w-full h-full object-cover" alt="Frozen food background with ice crystals" style="object-position: 50% 90%;">
                <div class="absolute inset-0 bg-black/40"></div>
                <div class="relative text-white p-8" data-aos="zoom-in">
                    <h1 class="font-serif text-4xl md:text-7xl font-bold">Myths About Frozen Foods</h1>
                    <p class="mt-4 text-lg md:text-xl max-w-2xl mx-auto">Shattering the Myths, Serving the Truth</p>
                </div>
            </div>
        </section>

        <!-- Intro Section -->
        <section class="py-16 lg:py-24">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="max-w-4xl mx-auto text-center">
                    <p class="text-lg text-text-secondary" data-aos="fade-up">
                        Frozen food has come a long way from the old-school image of soggy veggies and mystery meals. Yet, myths continue to cloud its reputation. At <strong>Nanshhuf</strong>, we’re here to set the record straight and show you why frozen is the smarter, fresher, and tastier choice.
                    </p>
                </div>
            </div>
        </section>

        <!-- Myths vs Facts Grid -->
        <section class="py-16 lg:py-24 bg-bg-card border-y border-gray-200">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
                    <!-- Myth Item -->
                    <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-200/50" data-aos="fade-up" data-aos-delay="100">
                        <div class="flex items-center">
                            <i data-lucide="x-circle" class="w-6 h-6 text-red-500 mr-3 flex-shrink-0"></i>
                            <h3 class="font-semibold text-lg text-gray-800">Myth: Frozen Food Lasts Forever</h3>
                        </div>
                        <div class="flex items-start mt-3 border-t border-gray-200 pt-3">
                            <i data-lucide="check-circle-2" class="w-6 h-6 text-green-600 mr-3 mt-1 flex-shrink-0"></i>
                            <div>
                                <h4 class="font-semibold text-green-800">Fact:</h4>
                                <p class="text-text-secondary">Freezing keeps food safe for long periods, but flavor and texture are best within recommended timelines. Proper storage = peak taste, every time.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Myth Item -->
                    <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-200/50" data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-center">
                            <i data-lucide="x-circle" class="w-6 h-6 text-red-500 mr-3 flex-shrink-0"></i>
                            <h3 class="font-semibold text-lg text-gray-800">Myth: Fresh is Always Healthier</h3>
                        </div>
                        <div class="flex items-start mt-3 border-t border-gray-200 pt-3">
                            <i data-lucide="check-circle-2" class="w-6 h-6 text-green-600 mr-3 mt-1 flex-shrink-0"></i>
                            <div>
                                <h4 class="font-semibold text-green-800">Fact:</h4>
                                <p class="text-text-secondary">Rapid-freezing locks in nutrients at their peak. Studies show frozen veggies often have equal or even higher nutrient levels compared to “fresh” produce.</p>
                            </div>
                        </div>
                    </div>
                     <!-- Myth Item -->
                     <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-200/50" data-aos="fade-up" data-aos-delay="100">
                        <div class="flex items-center">
                            <i data-lucide="x-circle" class="w-6 h-6 text-red-500 mr-3 flex-shrink-0"></i>
                            <h3 class="font-semibold text-lg text-gray-800">Myth: Frozen Food = Processed Junk</h3>
                        </div>
                        <div class="flex items-start mt-3 border-t border-gray-200 pt-3">
                            <i data-lucide="check-circle-2" class="w-6 h-6 text-green-600 mr-3 mt-1 flex-shrink-0"></i>
                            <div>
                                <h4 class="font-semibold text-green-800">Fact:</h4>
                                <p class="text-text-secondary">Today’s frozen aisle is a health-conscious haven. Clean labels, fewer additives, and chef-inspired recipes make frozen meals a trusted choice.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Myth Item -->
                    <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-200/50" data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-center">
                            <i data-lucide="x-circle" class="w-6 h-6 text-red-500 mr-3 flex-shrink-0"></i>
                            <h3 class="font-semibold text-lg text-gray-800">Myth: Expiry Dates Mean the End</h3>
                        </div>
                        <div class="flex items-start mt-3 border-t border-gray-200 pt-3">
                            <i data-lucide="check-circle-2" class="w-6 h-6 text-green-600 mr-3 mt-1 flex-shrink-0"></i>
                            <div>
                                <h4 class="font-semibold text-green-800">Fact:</h4>
                                <p class="text-text-secondary">Sell-by and best-by dates are mostly for quality guidance. Frozen food stored properly remains safe and delicious well beyond those dates.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Myth Item -->
                    <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-200/50" data-aos="fade-up" data-aos-delay="100">
                        <div class="flex items-center">
                           <i data-lucide="x-circle" class="w-6 h-6 text-red-500 mr-3 flex-shrink-0"></i>
                            <h3 class="font-semibold text-lg text-gray-800">Myth: Freezing Kills Bacteria</h3>
                        </div>
                        <div class="flex items-start mt-3 border-t border-gray-200 pt-3">
                           <i data-lucide="check-circle-2" class="w-6 h-6 text-green-600 mr-3 mt-1 flex-shrink-0"></i>
                            <div>
                                <h4 class="font-semibold text-green-800">Fact:</h4>
                                <p class="text-text-secondary">Freezing only pauses microbial activity. Handle thawed food safely—thaw in the fridge, not on the counter—to enjoy every bite with confidence.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Myth Item -->
                    <div class="bg-white p-6 rounded-lg shadow-lg border border-gray-200/50" data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-center">
                            <i data-lucide="x-circle" class="w-6 h-6 text-red-500 mr-3 flex-shrink-0"></i>
                            <h3 class="font-semibold text-lg text-gray-800">Myth: Frozen Food is Flavorless</h3>
                        </div>
                        <div class="flex items-start mt-3 border-t border-gray-200 pt-3">
                            <i data-lucide="check-circle-2" class="w-6 h-6 text-green-600 mr-3 mt-1 flex-shrink-0"></i>
                            <div>
                                <h4 class="font-semibold text-green-800">Fact:</h4>
                                <p class="text-text-secondary">With modern freezing methods, flavors are sealed in at their peak. The result? Dishes that taste as vibrant and fresh as the day they were made.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

         <!-- CTA Section -->
        <section class="py-16 lg:py-24">
            <div class="container mx-auto px-4 lg:px-6 text-center">
                <div data-aos="fade-up">
                    <i data-lucide="award" class="w-12 h-12 text-accent-brown mx-auto mb-4"></i>
                    <h2 class="font-serif text-2xl md:text-4xl text-accent-brown">The Frozen Truth</h2>
                    <p class="text-lg max-w-3xl mx-auto mt-4 text-text-secondary">Frozen food isn’t the enemy—it’s the evolution of modern eating: <strong>nutritious, safe, sustainable, and delicious.</strong> With Nanshhuf, you’re not just eating frozen, you’re eating <strong>smarter, fresher, and better.</strong></p>
                </div>
            </div>
        </section>
    </main>

<%- include('partials/footer') -%>
<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
    