                        </div>
                        <div class="relative mb-4">
                             <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                                <i data-lucide="mail" class="w-5 h-5 text-gray-400"></i>
                            </div>
                            <input type="email" id="signup-email" placeholder="Email Address" class="w-full p-3 bg-gray-100 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-brown focus:border-transparent pl-10 text-text-primary placeholder-gray-500 transition">
                        </div>
                        <div class="relative mb-4">
                             <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                               <i data-lucide="lock" class="w-5 h-5 text-gray-400"></i>
                            </div>
                            <input type="password" id="signup-password" placeholder="Password" class="w-full p-3 bg-gray-100 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-brown focus:border-transparent pl-10 text-text-primary placeholder-gray-500 transition">
