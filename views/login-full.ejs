                        </div>
                        <div id="forgot-message" class="text-center text-sm font-medium mb-4 h-5"></div>
                        <button type="submit" class="w-full py-3 px-6 rounded-lg text-white font-bold bg-gradient-to-r from-[#8C6A5D] to-[#73564B] hover:from-[#73564B] hover:to-[#8C6A5D] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8C6A5D] transition-all duration-300 transform hover:scale-105 mt-6">Send Reset Link</button>
                    </form>
                    <div class="mt-6 text-center">
                        <p class="text-sm text-text-secondary">
                            Remembered your password? <a href="#" id="show-login-btn-from-forgot" class="font-bold text-accent-brown hover:underline">Log In</a>
                        </p>
                    </div>
                </div>
            </div>

        </div>
   </div>
</main>

<script src="/assets/js/login.js"></script>

<script>
    // Ensure login/signup/forgot panel toggles work even if router initializers didn't attach.
    (function(){
        function switchPanel(panelToShow){
            const loginPanel = document.getElementById('login-panel');
            const signupPanel = document.getElementById('signup-panel');
            const forgotPanel = document.getElementById('forgot-panel');
            const panels = [loginPanel, signupPanel, forgotPanel].filter(Boolean);
            panels.forEach(panel => {
                panel.classList.add('transition-transform','duration-500','ease-in-out');
                if (panel !== panelToShow) {
                    panel.classList.add(panel === loginPanel ? '-translate-x-full' : 'translate-x-full');
                    panel.classList.remove('translate-x-0');
                }
            });
            if (panelToShow) {
                panelToShow.classList.remove('-translate-x-full','translate-x-full');
                panelToShow.classList.add('translate-x-0');
            }
        }

        document.getElementById('show-signup-btn')?.addEventListener('click', function(e){ e.preventDefault(); switchPanel(document.getElementById('signup-panel')); });
        document.getElementById('show-login-btn-from-signup')?.addEventListener('click', function(e){ e.preventDefault(); switchPanel(document.getElementById('login-panel')); });
        document.getElementById('show-forgot-btn')?.addEventListener('click', function(e){ e.preventDefault(); switchPanel(document.getElementById('forgot-panel')); });
        document.getElementById('show-login-btn-from-forgot')?.addEventListener('click', function(e){ e.preventDefault(); switchPanel(document.getElementById('login-panel')); });
    })();
</script>

<script>
    // Inline signup form submit handler (fallback) to POST to API when router code is not present
    (function(){
        const signupForm = document.getElementById('signup-form');
        if (!signupForm || signupForm.dataset.inlineHandlerAttached) return;
        signupForm.dataset.inlineHandlerAttached = '1';

        const showMessage = (text, isError) => {
            const el = document.getElementById('signup-message');
            if (!el) return;
            el.innerText = text;
            el.className = `text-center text-sm font-medium mb-4 h-5 ${isError ? 'text-red-500' : 'text-green-500'}`;
            if (!isError) setTimeout(() => el.innerText = '', 3000);
        };

        signupForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const fullName = (document.getElementById('signup-fullname') || document.getElementById('signup-name'))?.value || '';
            const email = document.getElementById('signup-email')?.value || '';
            const password = document.getElementById('signup-password')?.value || '';
            const confirm = (document.getElementById('confirm-password') || document.getElementById('signup-confirm-password'))?.value || '';
            if (password !== confirm) {
                showMessage('Passwords do not match!', true);
                return;
            }
            try {
                const res = await fetch('/api/auth/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fullName, email, password })
                });
                const data = await res.json().catch(() => ({}));
                if (res.ok) {
                    showMessage('Signup successful! Redirecting to login...', false);
                    setTimeout(() => {
                        // switch to login panel
                        const loginPanel = document.getElementById('login-panel');
                        const signupPanel = document.getElementById('signup-panel');
                        if (signupPanel) { signupPanel.classList.add('translate-x-full'); signupPanel.classList.remove('translate-x-0'); }
                        if (loginPanel) { loginPanel.classList.remove('-translate-x-full'); loginPanel.classList.add('translate-x-0'); }
                    }, 1200);
                } else {
                    showMessage(data.message || 'Signup failed', true);
                }
            } catch (err) {
                showMessage('Server error. Please try again later.', true);
            }
        });
    })();
</script>

<%- include('partials/footer') -%>