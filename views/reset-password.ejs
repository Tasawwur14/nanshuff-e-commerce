<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Nanshhuf</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/index.css">
</head>
<body class="bg-bg-primary text-text-primary min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-md">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <a href="/" class="text-2xl font-bold text-accent-brown">Nanshhuf</a>
            <nav>
                <a href="/" class="text-text-secondary hover:text-accent-brown mr-6">Home</a>
                <a href="/products" class="text-text-secondary hover:text-accent-brown">Products</a>
            </nav>
        </div>
    </header>

    <main class="container mx-auto px-4 py-12">
        <div class="max-w-md mx-auto bg-white p-8 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-center mb-6 text-text-primary">Reset Your Password</h2>
            <p class="text-center text-text-secondary mb-6">Enter your new password</p>
            
            <form id="reset-password-form">
                <input type="hidden" id="token" value="<%= token %>">
                
                <div class="mb-4">
                    <label for="new-password" class="block text-text-secondary mb-2">New Password</label>
                    <input 
                        type="password" 
                        id="new-password" 
                        name="newPassword" 
                        required 
                        minlength="6"
                        class="w-full p-3 bg-bg-light border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-brown focus:border-transparent text-text-primary"
                        placeholder="Enter new password"
                    >
                    <div id="password-error" class="text-red-500 text-sm mt-1 h-5"></div>
                </div>
                
                <div class="mb-6">
                    <label for="confirm-password" class="block text-text-secondary mb-2">Confirm Password</label>
                    <input 
                        type="password" 
                        id="confirm-password" 
                        name="confirmPassword" 
                        required 
                        minlength="6"
                        class="w-full p-3 bg-bg-light border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-brown focus:border-transparent text-text-primary"
                        placeholder="Confirm new password"
                    >
                    <div id="confirm-password-error" class="text-red-500 text-sm mt-1 h-5"></div>
                </div>
                
                <button 
                    type="submit" 
                    id="reset-password-btn"
                    class="w-full text-white py-3 px-4 rounded-lg bg-gradient-to-r from-[#8C6A5D] to-[#73564B] hover:from-[#73564B] hover:to-[#8C6A5D] transition duration-300 font-bold shadow-md hover:shadow-lg"
                >
                    Reset Password
                </button>
                
                <div id="reset-message" class="text-center text-sm font-medium mb-4 mt-4 min-h-[1.25rem]"></div>
            </form>
            
            <div class="text-center mt-6">
                <a href="/login" class="text-accent-brown hover:underline">Back to Login</a>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('reset-password-form');
            const newPasswordInput = document.getElementById('new-password');
            const confirmPasswordInput = document.getElementById('confirm-password');
            const resetMessage = document.getElementById('reset-message');
            const passwordError = document.getElementById('password-error');
            const confirmPasswordError = document.getElementById('confirm-password-error');
            const resetBtn = document.getElementById('reset-password-btn');
            
            // Get token from URL if not provided in template
            const urlParams = new URLSearchParams(window.location.search);
            const token = document.getElementById('token').value || urlParams.get('token');
            
            if (!token) {
                resetMessage.textContent = 'Invalid reset link. Please try again.';
                resetMessage.classList.add('text-red-500');
                resetBtn.disabled = true;
                return;
            }
            
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                // Clear previous errors
                resetMessage.textContent = '';
                passwordError.textContent = '';
                confirmPasswordError.textContent = '';
                
                const newPassword = newPasswordInput.value;
                const confirmPassword = confirmPasswordInput.value;
                
                // Validate passwords match
                if (newPassword !== confirmPassword) {
                    confirmPasswordError.textContent = 'Passwords do not match';
                    return;
                }
                
                // Validate password length
                if (newPassword.length < 6) {
                    passwordError.textContent = 'Password must be at least 6 characters';
                    return;
                }
                
                try {
                    resetBtn.disabled = true;
                    resetBtn.textContent = 'Resetting...';
                    
                    const response = await fetch('/api/auth/reset-password', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            token,
                            newPassword,
                            confirmPassword
                        })
                    });
                    
                    const data = await response.json();
                    
                    if (response.ok) {
                        resetMessage.textContent = 'Password reset successfully! Redirecting to login...';
                        resetMessage.className = 'text-center text-sm font-medium mb-4 mt-4 min-h-[1.25rem] text-green-600';
                        
                        // Redirect to login after a delay
                        setTimeout(() => {
                            window.location.href = '/login';
                        }, 2000);
                    } else {
                        resetMessage.textContent = data.message || 'Failed to reset password';
                        resetMessage.className = 'text-center text-sm font-medium mb-4 mt-4 min-h-[1.25rem] text-red-500';
                    }
                } catch (error) {
                    console.error('Error resetting password:', error);
                    resetMessage.textContent = 'An error occurred. Please try again.';
                    resetMessage.className = 'text-center text-sm font-medium mb-4 mt-4 min-h-[1.25rem] text-red-500';
                } finally {
                    resetBtn.disabled = false;
                    resetBtn.textContent = 'Reset Password';
                }
            });
        });
    </script>
</body>
</html>