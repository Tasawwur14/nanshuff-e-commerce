<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Nanshhuf</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/assets/css/admindashboard.css">
</head>
<body class="bg-bg-light text-text-primary">

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside id="sidebar" class="fixed top-0 left-0 z-40 w-64 h-screen bg-white border-r border-gray-200 sidebar md:translate-x-0 -translate-x-full">
            <div class="flex items-center justify-between h-20 border-b border-gray-200 px-4">
                <img src="/images/brand/Eagle%20logo.png" alt="Nanshhuf" class="h-8">
                <button id="sidebar-close-btn" class="text-text-primary focus:outline-none md:hidden">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <nav id="sidebar-nav" class="mt-4">
                <a href="#" data-page="dashboard" class="sidebar-link active flex items-center px-6 py-3 text-text-secondary">
                    <i data-lucide="layout-dashboard" class="w-5 h-5 mr-3"></i>
                    <span>Dashboard</span>
                </a>
                <a href="#" data-page="products" class="sidebar-link flex items-center px-6 py-3 text-text-secondary">
                    <i data-lucide="package" class="w-5 h-5 mr-3"></i>
                    <span>Products</span>
                </a>
                <a href="#" data-page="orders" class="sidebar-link flex items-center px-6 py-3 text-text-secondary">
                    <i data-lucide="shopping-cart" class="w-5 h-5 mr-3"></i>
                    <span>Orders</span>
                </a>
                <a href="#" data-page="customers" class="sidebar-link flex items-center px-6 py-3 text-text-secondary">
                    <i data-lucide="users" class="w-5 h-5 mr-3"></i>
                    <span>Customers</span>
                </a>
                <a href="#" data-page="analytics" class="sidebar-link flex items-center px-6 py-3 text-text-secondary">
                    <i data-lucide="bar-chart-2" class="w-5 h-5 mr-3"></i>
                    <span>Analytics</span>
                </a>
                 <a href="#" data-page="marketing" class="sidebar-link flex items-center px-6 py-3 text-text-secondary">
                    <i data-lucide="megaphone" class="w-5 h-5 mr-3"></i>
                    <span>Marketing</span>
                </a>
                <a href="#" data-page="settings" class="sidebar-link flex items-center px-6 py-3 text-text-secondary">
                    <i data-lucide="settings" class="w-5 h-5 mr-3"></i>
                    <span>Settings</span>
                </a>
            </nav>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden md:ml-64">
            <!-- Header -->
            <header class="flex justify-between items-center p-4 h-20 bg-white border-b border-gray-200 flex-shrink-0">
                <div class="flex items-center">
                    <button id="sidebar-toggle" class="text-text-primary focus:outline-none md:hidden">
                        <i data-lucide="menu" class="w-6 h-6"></i>
                    </button>
                    <h1 id="header-title" class="text-2xl font-semibold text-text-primary ml-4">Dashboard</h1>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <button id="notification-btn" class="p-2 bg-gray-100 rounded-full hover:bg-gray-200 focus:outline-none relative">
                            <i data-lucide="bell" class="w-6 h-6 text-text-secondary"></i>
                            <span class="notification-dot"></span>
                        </button>
                        <!-- Notification Dropdown -->
                        <div id="notification-dropdown" class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-lg overflow-hidden z-20 hidden dropdown opacity-0 transform scale-95">
                            <div class="py-2 px-4 font-semibold text-text-primary border-b border-gray-200">Notifications</div>
                            <div class="flex flex-col">
                                <a href="#" class="flex items-start px-4 py-3 hover:bg-gray-100">
                                    <div class="text-green-500 mr-3 mt-1"><i data-lucide="shopping-cart" class="w-5 h-5"></i></div>
                                    <div><p class="text-sm font-medium">New order #AUR8574 received</p><p class="text-xs text-gray-500">2 minutes ago</p></div>
                                </a>
                                <a href="#" class="flex items-start px-4 py-3 hover:bg-gray-100">
                                    <div class="text-red-500 mr-3 mt-1"><i data-lucide="package-x" class="w-5 h-5"></i></div>
                                    <div><p class="text-sm font-medium">Celestial Glow Serum is out of stock</p><p class="text-xs text-gray-500">1 hour ago</p></div>
                                </a>
                                 <a href="#" class="flex items-start px-4 py-3 hover:bg-gray-100">
                                    <div class="text-blue-500 mr-3 mt-1"><i data-lucide="file-text" class="w-5 h-5"></i></div>
                                    <div><p class="text-sm font-medium">Weekly sales report is ready</p><p class="text-xs text-gray-500">Yesterday</p></div>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="relative">
                        <button id="user-menu-btn" class="flex items-center focus:outline-none">
                            <img class="w-10 h-10 rounded-full object-cover" src="https://placehold.co/100x100/8C6A5D/FFFFFF?text=A" alt="Admin">
                            <div class="ml-3 text-left hidden md:block">
                                <p class="text-sm font-medium text-text-primary">Admin User</p>
                                <p class="text-xs text-text-secondary">Super Admin</p>
                            </div>
                        </button>
                        <!-- User Dropdown -->
                        <div id="user-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg overflow-hidden z-20 hidden dropdown opacity-0 transform scale-95">
                            <a href="#" id="profile-link" class="block px-4 py-2 text-sm text-text-secondary hover:bg-gray-100">My Profile</a>
                            <a href="#" id="settings-link-from-profile" class="block px-4 py-2 text-sm text-text-secondary hover:bg-gray-100">Settings</a>
                            <div class="border-t border-gray-200"></div>
                            <a href="#" id="logout-btn" class="block px-4 py-2 text-sm text-text-secondary hover:bg-gray-100">Logout</a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main content area -->
            <div class="flex-1 overflow-x-hidden overflow-y-auto bg-bg-light">
                
                <!-- DASHBOARD PAGE -->
                <main id="page-dashboard" class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                        <div class="stat-card rounded-lg p-6">
                            <div class="flex items-center"><div class="p-3 rounded-full bg-blue-100 text-blue-500"><i data-lucide="dollar-sign" class="w-6 h-6"></i></div><div class="ml-4"><p class="text-sm text-text-secondary">Total Revenue</p><p class="text-2xl font-semibold text-text-primary" id="dashboard-revenue">Loading...</p></div></div>
                        </div>
                         <div class="stat-card rounded-lg p-6">
                            <div class="flex items-center"><div class="p-3 rounded-full bg-green-100 text-green-500"><i data-lucide="shopping-bag" class="w-6 h-6"></i></div><div class="ml-4"><p class="text-sm text-text-secondary">New Orders</p><p class="text-2xl font-semibold text-text-primary" id="dashboard-orders">Loading...</p></div></div>
                        </div>
                         <div class="stat-card rounded-lg p-6">
                            <div class="flex items-center"><div class="p-3 rounded-full bg-yellow-100 text-yellow-500"><i data-lucide="user-plus" class="w-6 h-6"></i></div><div class="ml-4"><p class="text-sm text-text-secondary">New Customers</p><p class="text-2xl font-semibold text-text-primary" id="dashboard-customers">Loading...</p></div></div>
                        </div>
                         <div class="stat-card rounded-lg p-6">
                            <div class="flex items-center"><div class="p-3 rounded-full bg-red-100 text-red-500"><i data-lucide="trending-up" class="w-6 h-6"></i></div><div class="ml-4"><p class="text-sm text-text-secondary">Conversion Rate</p><p class="text-2xl font-semibold text-text-primary" id="dashboard-conversion">Loading...</p></div></div>
                        </div>
                    </div>
                    <div class="bg-white rounded-lg p-6 mb-6 border border-gray-200">
                        <h2 class="text-xl font-semibold mb-4">Sales Overview (Last 30 Days)</h2>
                        <div class="relative h-96">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>
                </main>

                <!-- PRODUCTS PAGE -->
                <main id="page-products" class="p-6 hidden">
                    <div class="bg-white rounded-lg border border-gray-200">
                        <div class="p-6 flex justify-between items-center border-b border-gray-200 flex-wrap gap-4">
                            <h2 class="text-xl font-semibold">Manage Products</h2>
                            <button id="add-product-btn" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg flex items-center">
                                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>Add New Product
                            </button>
                        </div>
                        <div class="p-6 flex flex-col md:flex-row gap-4 items-center justify-between">
                            <div class="relative w-full md:w-1/3">
                                <input type="text" id="product-search" placeholder="Search by name or SKU..." class="input-field w-full p-3 pl-10">
                                <i data-lucide="search" class="w-5 h-5 text-gray-400 absolute top-1/2 left-3 -translate-y-1/2"></i>
                            </div>
                            <div class="w-full md:w-auto md:w-1/4">
                                <select id="product-category-filter" class="input-field w-full p-3"></select>
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead class="table-header">
                                    <tr>
                                        <th class="p-4 font-semibold">Product</th>
                                        <th class="p-4 font-semibold hidden md:table-cell">Category</th>
                                        <th class="p-4 font-semibold hidden lg:table-cell">Price (₹)</th>
                                        <th class="p-4 font-semibold hidden lg:table-cell">Stock</th>
                                        <th class="p-4 font-semibold">Status</th>
                                        <th class="p-4 font-semibold">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="products-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </main>

                <!-- ORDERS PAGE -->
                <main id="page-orders" class="p-6 hidden">
                     <div class="bg-white rounded-lg border border-gray-200">
                        <div class="p-6"><h2 class="text-xl font-semibold">Manage Orders</h2></div>
                        <div class="overflow-x-auto"><table class="w-full text-left"><thead class="table-header"><tr><th class="p-4 font-semibold">Order ID</th><th class="p-4 font-semibold">Customer</th><th class="p-4 font-semibold">Date</th><th class="p-4 font-semibold">Total (₹)</th><th class="p-4 font-semibold">Status</th><th class="p-4 font-semibold">Actions</th></tr></thead><tbody id="orders-table-body"></tbody></table></div>
                    </div>
                </main>

                <!-- CUSTOMERS PAGE -->
                <main id="page-customers" class="p-6 hidden">
                    <div class="bg-white rounded-lg border border-gray-200">
                        <div class="p-6 flex justify-between items-center border-b border-gray-200 flex-wrap gap-4">
                            <h2 class="text-xl font-semibold">Manage Customers</h2>
                            <button id="refresh-customers-btn" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg flex items-center">
                                <i data-lucide="refresh-cw" class="w-5 h-5 mr-2"></i>Refresh Customers
                            </button>
                        </div>
                        <div class="overflow-x-auto"><table class="w-full text-left"><thead class="table-header"><tr><th class="p-4 font-semibold">Customer Name</th><th class="p-4 font-semibold">Email</th><th class="p-4 font-semibold">Join Date</th><th class="p-4 font-semibold">Total Orders</th><th class="p-4 font-semibold">Total Spent (₹)</th><th class="p-4 font-semibold">Actions</th></tr></thead><tbody id="customers-table-body"></tbody></table></div>
                    </div>
                </main>

                <!-- ANALYTICS PAGE -->
                <main id="page-analytics" class="p-6 hidden">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                        <div class="stat-card rounded-lg p-6"><h3 class="text-sm text-text-secondary">Total Sales</h3><p id="analytics-total-sales" class="text-3xl font-semibold text-text-primary mt-2"></p></div>
                        <div class="stat-card rounded-lg p-6"><h3 class="text-sm text-text-secondary">Total Orders</h3><p id="analytics-total-orders" class="text-3xl font-semibold text-text-primary mt-2"></p></div>
                        <div class="stat-card rounded-lg p-6"><h3 class="text-sm text-text-secondary">Avg. Order Value</h3><p id="analytics-avg-order" class="text-3xl font-semibold text-text-primary mt-2"></p></div>
                        <div class="stat-card rounded-lg p-6"><h3 class="text-sm text-text-secondary">New Customers</h3><p id="analytics-new-customers" class="text-3xl font-semibold text-text-primary mt-2"></p></div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
                        <div class="lg:col-span-3 bg-white rounded-lg p-6 border border-gray-200">
                            <h3 class="text-xl font-semibold mb-4">Top Selling Products</h3>
                            <div class="relative h-96">
                                <canvas id="topProductsChart"></canvas>
                            </div>
                        </div>
                        <div class="lg:col-span-2 bg-white rounded-lg p-6 border border-gray-200">
                            <h3 class="text-xl font-semibold mb-4">Sales by Category</h3>
                            <div class="relative h-96 flex justify-center items-center">
                                <canvas id="salesByCategoryChart"></canvas>
                            </div>
                        </div>
                    </div>
                </main>

                <!-- MARKETING PAGE -->
                <main id="page-marketing" class="p-6 hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Discount Codes -->
                        <div class="bg-white rounded-lg border border-gray-200">
                            <div class="p-6 flex justify-between items-center"><h2 class="text-xl font-semibold">Discount Codes</h2><button id="add-discount-btn" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg flex items-center"><i data-lucide="plus" class="w-5 h-5 mr-2"></i>Create Code</button></div>
                            <div class="overflow-x-auto"><table class="w-full text-left"><thead class="table-header"><tr><th class="p-4 font-semibold">Code</th><th class="p-4 font-semibold">Discount</th><th class="p-4 font-semibold">Status</th><th class="p-4 font-semibold">Actions</th></tr></thead><tbody id="discounts-table-body"></tbody></table></div>
                        </div>
                        <!-- Email Campaign -->
                        <div class="bg-white rounded-lg border border-gray-200 p-6">
                            <h2 class="text-xl font-semibold mb-4">Email Campaign</h2>
                            <form id="email-campaign-form">
                                <div><label for="email-subject" class="block mb-2 text-sm font-medium text-text-secondary">Subject</label><input type="text" id="email-subject" class="input-field w-full p-3" required></div>
                                <div class="mt-4"><label for="email-body" class="block mb-2 text-sm font-medium text-text-secondary">Message</label><textarea id="email-body" rows="8" class="input-field w-full p-3" required></textarea></div>
                                <div class="mt-6 text-right"><button type="submit" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-3 px-6 rounded-lg">Send to All Customers</button></div>
                            </form>
                        </div>
                    </div>
                </main>
                
                <!-- SETTINGS PAGE -->
                <main id="page-settings" class="p-6 hidden">
                    <div class="bg-white rounded-lg border border-gray-200">
                        <div class="p-6 border-b border-gray-200">
                            <div id="settings-tabs" class="flex space-x-8">
                                <button data-tab="general" class="tab-button text-lg font-semibold border-b-2 border-transparent pb-2 active">General</button>
                                <button data-tab="account" class="tab-button text-lg font-semibold border-b-2 border-transparent pb-2">Account</button>
                                <button data-tab="payment" class="tab-button text-lg font-semibold border-b-2 border-transparent pb-2">Payment</button>
                                <button data-tab="shipping" class="tab-button text-lg font-semibold border-b-2 border-transparent pb-2">Shipping</button>
                            </div>
                        </div>
                        <div class="p-8">
                            <!-- General Settings Tab -->
                            <div id="tab-general" class="settings-tab-content">
                                <form class="space-y-6 max-w-lg">
                                    <div><label for="store-name" class="block mb-2 text-sm font-medium text-text-secondary">Store Name</label><input type="text" id="store-name" value="Aurum Cosmetics" class="input-field w-full p-3"></div>
                                    <div><label for="store-email" class="block mb-2 text-sm font-medium text-text-secondary">Contact Email</label><input type="email" id="store-email" value="contact@aurum.com" class="input-field w-full p-3"></div>
                                    <div><label for="store-currency" class="block mb-2 text-sm font-medium text-text-secondary">Currency</label><select id="store-currency" class="input-field w-full p-3"><option>USD ($)</option><option selected>INR (₹)</option><option>EUR (€)</option></select></div>
                                    <div class="pt-4"><button type="submit" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-3 px-6 rounded-lg">Save General Settings</button></div>
                                </form>
                            </div>
                            <!-- Account Settings Tab -->
                            <div id="tab-account" class="settings-tab-content hidden">
                                <form class="space-y-6 max-w-lg">
                                    <div><label for="admin-name" class="block mb-2 text-sm font-medium text-text-secondary">Your Name</label><input type="text" id="admin-name" value="Admin User" class="input-field w-full p-3"></div>
                                    <div><label for="admin-email" class="block mb-2 text-sm font-medium text-text-secondary">Your Email</label><input type="email" id="admin-email" value="admin@aurum.com" class="input-field w-full p-3"></div>
                                    <div><label for="admin-old-password" class="block mb-2 text-sm font-medium text-text-secondary">Old Password</label><input type="password" id="admin-old-password" class="input-field w-full p-3"></div>
                                    <div><label for="admin-new-password" class="block mb-2 text-sm font-medium text-text-secondary">New Password</label><input type="password" id="admin-new-password" class="input-field w-full p-3"></div>
                                    <div class="pt-4"><button type="submit" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-3 px-6 rounded-lg">Update Account</button></div>
                                </form>
                            </div>
                            <!-- Payment Settings Tab -->
                            <div id="tab-payment" class="settings-tab-content hidden">
                                <div class="space-y-6 max-w-lg">
                                    <div class="bg-gray-100 p-4 rounded-lg"><h3 class="font-semibold">Stripe</h3><p class="text-sm text-text-secondary">API Key: sk_test_********************</p></div>
                                    <div class="bg-gray-100 p-4 rounded-lg"><h3 class="font-semibold">PayPal</h3><p class="text-sm text-text-secondary">Client ID: A*******************</p></div>
                                    <div class="pt-4"><button class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-3 px-6 rounded-lg">Connect New Gateway</button></div>
                                </div>
                            </div>
                            <!-- Shipping Settings Tab -->
                            <div id="tab-shipping" class="settings-tab-content hidden">
                                <div class="space-y-6 max-w-lg">
                                    <div><h3 class="font-semibold text-lg">Shipping Zones</h3></div>
                                    <div class="bg-gray-100 p-4 rounded-lg"><h4 class="font-semibold">Domestic (India)</h4><p class="text-sm text-text-secondary">Standard Shipping: ₹50.00</p><p class="text-sm text-text-secondary">Express Shipping: ₹100.00</p></div>
                                    <div class="bg-gray-100 p-4 rounded-lg"><h4 class="font-semibold">International</h4><p class="text-sm text-text-secondary">Standard Shipping: ₹1500.00</p></div>
                                    <div class="pt-4"><button class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-3 px-6 rounded-lg">Add Shipping Zone</button></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>

            </div>
        </div>
    </div>

    <!-- Modals -->
    <div id="product-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-70 modal hidden p-4">
        <div class="modal-content bg-white rounded-lg shadow-xl w-full max-w-4xl transform scale-95 opacity-0 flex flex-col max-h-[90vh]">
             <div class="relative flex justify-between items-center p-6 border-b border-gray-200 flex-shrink-0">
                <h3 id="modal-title" class="text-2xl font-semibold">Add New Product</h3>
                <div id="product-modal-tabs" class="absolute left-1/2 -translate-x-1/2 flex space-x-1 border border-gray-200 rounded-lg p-1">
                    <button data-tab="product-general" class="tab-button text-sm font-semibold px-4 py-1 rounded-md active">General</button>
                    <button data-tab="product-media" class="tab-button text-sm font-semibold px-4 py-1 rounded-md">Media</button>
                    <button data-tab="product-details" class="tab-button text-sm font-semibold px-4 py-1 rounded-md">Details</button>
                    <button data-tab="product-pricing" class="tab-button text-sm font-semibold px-4 py-1 rounded-md">Pricing & Stock</button>
                </div>
                <button id="close-product-modal-btn" class="text-text-secondary hover:text-text-primary text-3xl">&times;</button>
            </div>
            <form id="product-form" class="flex-1 overflow-y-auto" novalidate>
                <div class="p-6">
                    <!-- General Tab -->
                    <div id="tab-product-general" class="product-tab-content space-y-6">
                        <div><label for="product-name" class="block mb-2 text-sm font-medium text-text-secondary">Product Name <span class="text-red-500">*</span></label><input type="text" id="product-name" class="input-field w-full p-3" required></div>
                        <div><label for="product-sku" class="block mb-2 text-sm font-medium text-text-secondary">SKU <span class="text-red-500">*</span></label><input type="text" id="product-sku" class="input-field w-full p-3" required></div>
                        <div class="col-span-2 md:col-span-1">
                            <label for="product-category-select" class="block mb-2 text-sm font-medium text-text-secondary">Category</label>
                            <select id="product-category-select" class="input-field w-full p-3"></select>
                            <input type="text" id="new-category-input" class="input-field w-full p-3 mt-2 hidden" placeholder="Enter new category name">
                        </div>
                        <div class="col-span-2 md:col-span-1">
                            <label for="product-weight" class="block mb-2 text-sm font-medium text-text-secondary">Weight</label>
                            <input type="text" id="product-weight" placeholder="e.g., 500g or 1kg" class="input-field w-full">
                        </div>
                        <div class="col-span-2">
                            <label for="product-tags" class="block mb-2 text-sm font-medium text-text-secondary">Tags (comma-separated)</label>
                            <input type="text" id="product-tags" class="input-field w-full">
                        </div>
                        <div class="col-span-2 flex items-center">
                            <label class="flex items-center cursor-pointer">
                                <input type="checkbox" id="product-featured" class="form-checkbox h-5 w-5 text-[#8C6A5D]">
                                <span class="ml-2 text-sm text-text-secondary">Featured Product</span>
                            </label>
                        </div>
                        <div>
                            <label class="block mb-2 text-sm font-medium text-text-secondary">Related Products</label>
                            <div class="custom-select-container bg-gray-100 p-2">
                                <div id="related-products-tags" class="flex flex-wrap gap-2 mb-2"></div>
                                <select id="related-products-select" class="input-field w-full p-3 border-t border-gray-200 focus:outline-none"></select>
                            </div>
                        </div>
                    </div>
                     <!-- Media Tab -->
                    <div id="tab-product-media" class="product-tab-content space-y-6 hidden">
                        <div>
                            <label class="block mb-2 text-sm font-medium text-text-secondary">Main Image</label>
                            <div class="bg-gray-100 p-4 rounded-lg flex items-center space-x-4">
                                <div class="relative">
                                    <img id="main-image-preview" src="https://placehold.co/100x100/8C6A5D/FFFFFF?text=Upload" class="w-24 h-24 object-cover rounded-md">
                                    <button type="button" id="remove-main-image-btn" class="hidden absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs">&times;</button>
                                </div>
                                <input type="file" id="main-image-input" class="hidden" accept="image/*">
                                <button type="button" id="upload-main-image-btn" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg">Upload Image</button>
                            </div>
                        </div>
                         <div>
                            <label class="block mb-2 text-sm font-medium text-text-secondary">Image Gallery</label>
                            <div class="bg-gray-100 p-4 rounded-lg">
                                <input type="file" id="gallery-images-input" class="hidden" multiple accept="image/*">
                                <button type="button" id="upload-gallery-images-btn" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg mb-4">Upload Gallery Images</button>
                                <div id="gallery-images-preview" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4"></div>
                            </div>
                        </div>
                        <div>
                            <label class="block mb-2 text-sm font-medium text-text-secondary">Product Video</label>
                            <div class="bg-gray-100 p-4 rounded-lg flex items-center space-x-4">
                                <div class="relative">
                             <video id="video-preview" class="w-40 h-24 object-cover rounded-md bg-bg-light" controls muted>
                                 Your browser does not support the video tag.
                             </video>
                                    <button type="button" id="remove-video-btn" class="hidden absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs">&times;</button>
                                </div>
                                <input type="file" id="product-video-input" class="hidden" accept="video/*">
                                <button type="button" id="upload-video-btn" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg">Upload Video</button>
                            </div>
                        </div>
                    </div>
                    <!-- Details Tab -->
                    <div id="tab-product-details" class="product-tab-content space-y-6 hidden">
                        <div><label for="short-description" class="block mb-2 text-sm font-medium text-text-secondary">Short Description <span class="text-red-500">*</span></label><textarea id="short-description" rows="3" class="input-field w-full p-3" required></textarea></div>
                        <div><label for="long-description" class="block mb-2 text-sm font-medium text-text-secondary">Long Description <span class="text-red-500">*</span></label><textarea id="long-description" rows="6" class="input-field w-full p-3" required></textarea></div>
                        <div><label for="ingredients" class="block mb-2 text-sm font-medium text-text-secondary">Ingredients <span class="text-red-500">*</span></label><textarea id="ingredients" rows="4" class="input-field w-full p-3" required></textarea></div>
                        <div><label for="how-to-use" class="block mb-2 text-sm font-medium text-text-secondary">How to Use <span class="text-red-500">*</span></label><textarea id="how-to-use" rows="4" class="input-field w-full p-3" required></textarea></div>
                    </div>
                    <!-- Pricing & Stock Tab -->
                    <div id="tab-product-pricing" class="product-tab-content space-y-6 hidden">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div><label for="product-mrp" class="block mb-2 text-sm font-medium text-text-secondary">MRP (₹) <span class="text-red-500">*</span></label><input type="number" id="product-mrp" step="0.01" class="input-field w-full p-3" required></div>
                            <div><label for="product-discount" class="block mb-2 text-sm font-medium text-text-secondary">Discount (%) <span class="text-red-500">*</span></label><input type="number" id="product-discount" class="input-field w-full p-3" value="0" required></div>
                            <div><label for="product-price" class="block mb-2 text-sm font-medium text-text-secondary">Selling Price (₹)</label><input type="number" id="product-price" step="0.01" class="input-field w-full p-3 bg-gray-100 text-text-secondary" readonly></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div><label for="product-stock" class="block mb-2 text-sm font-medium text-text-secondary">Quantity <span class="text-red-500">*</span></label><input type="number" id="product-stock" class="input-field w-full p-3" required></div>
                            <div><label for="low-stock-threshold" class="block mb-2 text-sm font-medium text-text-secondary">Low Stock Threshold</label><input type="number" id="low-stock-threshold" class="input-field w-full p-3"></div>
                            <div><label for="product-status" class="block mb-2 text-sm font-medium text-text-secondary">Stock Status <span class="text-red-500">*</span></label><select id="product-status" class="input-field w-full p-3" required><option>In Stock</option><option>Out of Stock</option><option>Pre-Order</option><option>Coming Soon</option></select></div>
                        </div>
                    </div>
                </div>
                <div class="p-6 mt-auto flex justify-end flex-shrink-0 border-t border-gray-200">
                    <input type="hidden" id="product-id">
                    <button type="button" id="cancel-product-btn" class="login-btn bg-gray-200 hover:bg-gray-300 text-text-primary font-bold py-2 px-6 rounded-lg mr-4">Cancel</button>
                    <button type="submit" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-6 rounded-lg">Save Product</button>
                </div>
            </form>
        </div>
    </div>
    <div id="order-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-70 modal hidden">
        <div class="modal-content bg-white rounded-lg shadow-xl w-full max-w-3xl transform scale-95 opacity-0">
            <div class="flex justify-between items-center p-6 border-b border-gray-200"><h3 id="order-modal-title" class="text-2xl font-semibold">Order Details</h3><button id="close-order-modal-btn" class="text-text-secondary hover:text-text-primary text-3xl">&times;</button></div>
            <div class="p-6" id="order-modal-body"></div>
            <div class="p-6 bg-gray-100 flex justify-between items-center">
                 <div><label for="order-status-update" class="text-sm mr-2 text-text-secondary">Update Status:</label><select id="order-status-update" class="input-field p-2"><option>Processing</option><option>Shipped</option><option>Delivered</option><option>Cancelled</option></select></div>
                 <button id="update-order-status-btn" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-6 rounded-lg">Update</button>
            </div>
        </div>
    </div>
    <div id="customer-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-70 modal hidden">
        <div class="modal-content bg-white rounded-lg shadow-xl w-full max-w-4xl transform scale-95 opacity-0">
            <div class="flex justify-between items-center p-6 border-b border-gray-200"><h3 id="customer-modal-title" class="text-2xl font-semibold">Customer Details</h3><button id="close-customer-modal-btn" class="text-text-secondary hover:text-text-primary text-3xl">&times;</button></div>
            <div class="p-6" id="customer-modal-body"></div>
        </div>
    </div>
    <div id="discount-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-70 modal hidden">
        <div class="modal-content bg-white rounded-lg shadow-xl w-full max-w-lg transform scale-95 opacity-0">
            <div class="flex justify-between items-center p-6 border-b border-gray-200"><h3 id="discount-modal-title" class="text-2xl font-semibold">Create Discount Code</h3><button id="close-discount-modal-btn" class="text-text-secondary hover:text-text-primary text-3xl">&times;</button></div>
            <form id="discount-form" class="p-6">
                <input type="hidden" id="discount-id">
                <div><label for="discount-code" class="block mb-2 text-sm font-medium text-text-secondary">Discount Code</label><input type="text" id="discount-code" class="input-field w-full p-3" required></div>
                <div class="mt-4"><label for="discount-percent" class="block mb-2 text-sm font-medium text-text-secondary">Discount (%)</label><input type="number" id="discount-percent" class="input-field w-full p-3" required></div>
                <div class="mt-4"><label for="discount-status" class="block mb-2 text-sm font-medium text-text-secondary">Status</label><select id="discount-status" class="input-field w-full p-3"><option value="Active">Active</option><option value="Inactive">Inactive</option></select></div>
                <div class="mt-8 flex justify-end"><button type="button" id="cancel-discount-btn" class="login-btn bg-gray-200 hover:bg-gray-300 text-text-primary font-bold py-2 px-6 rounded-lg mr-4">Cancel</button><button type="submit" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-6 rounded-lg">Save Code</button></div>
            </form>
        </div>
    </div>
    <div id="profile-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-70 modal hidden p-4">
        <div class="modal-content bg-white rounded-lg shadow-xl w-full max-w-md lg:max-w-3xl transform scale-95 opacity-0 flex flex-col max-h-[90vh]">
            <div class="flex justify-between items-center p-6 border-b border-gray-200 flex-shrink-0"><h3 class="text-2xl font-semibold">My Profile</h3><button id="close-profile-modal-btn" class="text-text-secondary hover:text-text-primary text-3xl">&times;</button></div>
            <div class="p-8 overflow-y-auto">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="md:col-span-1 text-center">
                        <img id="profile-avatar-img" src="https://placehold.co/150x150/8C6A5D/FFFFFF?text=A" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover">
                        <input type="file" id="profile-avatar-input" class="hidden" accept="image/*">
                        <button id="upload-picture-btn" class="text-sm text-accent-brown hover:underline">Upload new picture</button>
                        <div class="mt-6 text-left space-y-2">
                            <p><strong class="text-text-secondary">Role:</strong><br> Super Admin</p>
                            <p><strong class="text-text-secondary">Joined:</strong><br> 2025-01-15</p>
                        </div>
                    </div>
                    <div class="md:col-span-2">
                        <form id="profile-info-form">
                            <h4 class="text-lg font-semibold mb-4 text-text-primary">Personal Information</h4>
                            <div class="space-y-4">
                                <div><label for="profile-username" class="block mb-2 text-sm font-medium text-text-secondary">Username</label><input type="text" id="profile-username" value="admin" class="input-field w-full p-3"></div>
                                <div><label for="profile-name" class="block mb-2 text-sm font-medium text-text-secondary">Name</label><input type="text" id="profile-name" value="Admin User" class="input-field w-full p-3"></div>
                                <div><label for="profile-email" class="block mb-2 text-sm font-medium text-text-secondary">Email Address</label><input type="email" id="profile-email" value="admin@aurum.com" class="input-field w-full p-3"></div>
                            </div>
                            <div class="mt-6"><button type="submit" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg">Save Information</button></div>
                        </form>
                        <hr class="my-8 border-gray-200">
                        <form id="profile-password-form">
                            <h4 class="text-lg font-semibold mb-4 text-text-primary">Change Password</h4>
                            <div class="space-y-4">
                                <div><label for="profile-old-password" class="block mb-2 text-sm font-medium text-text-secondary">Old Password</label><input type="password" id="profile-old-password" class="input-field w-full p-3"></div>
                                <div><label for="profile-new-password" class="block mb-2 text-sm font-medium text-text-secondary">New Password</label><input type="password" id="profile-new-password" class="input-field w-full p-3"></div>
                                <div><label for="profile-confirm-password" class="block mb-2 text-sm font-medium text-text-secondary">Confirm New Password</label><input type="password" id="profile-confirm-password" class="input-field w-full p-3"></div>
                            </div>
                            <div class="mt-6"><button type="submit" class="login-btn bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white font-bold py-2 px-4 rounded-lg">Update Password</button></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script>
    lucide.createIcons();
</script>
<script src="/assets/js/admindashboard.js"></script>
   
</body>
</html>