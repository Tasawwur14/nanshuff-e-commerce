    <script>
        // --- FIX 1: Flag to prevent double loading ---
        let hasLoadedFeaturedProducts = false;

        // Initialize AOS (Animate On Scroll)
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // Initialize Lucide icons
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        // NOTE: Mobile menu listeners are handled by SPARouter.initializeMobileHeader()
        // Router attaches listeners using event delegation, which persists across navigation
        // Do NOT attach listeners here - it causes duplicate listeners and conflicts

        // --- FIX 2: Placeholder function for the new button ---
        function addToCart(productId) {
            console.log(`Adding product ${productId} to cart.`);
            // TODO: Add your actual cart logic here (e.g., update badge, send API request)
            
            // Example: Update cart badge
            const badge = document.getElementById('cart-badge');
            if (badge) {
                let currentCount = parseInt(badge.textContent) || 0;
                currentCount++;
                badge.textContent = currentCount;
                badge.classList.remove('hidden');
            }
        }

        // Load featured products
        async function loadFeaturedProducts() {
            // --- FIX 1 (continued): Check flag to prevent re-running ---
            if (hasLoadedFeaturedProducts) return;
            hasLoadedFeaturedProducts = true; // Set flag immediately to prevent race conditions

            try {
                const response = await fetch('/api/products/featured');
                
                // Check response status and content-type before parsing JSON
                if (!response.ok) {
                    const contentType = response.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) {
                        const error = await response.json();
                        throw new Error(error.error || 'Failed to fetch featured products');
                    } else {
                        const text = await response.text();
                        throw new Error(text || `HTTP ${response.status}`);
                    }
                }
                
                const data = await response.json();
                
                const productGrid = document.getElementById('product-grid');
                // Handle both array response and object with products property
                const products = Array.isArray(data) ? data : (data.products || []);
                if (productGrid && products && products.length > 0) {
                    productGrid.innerHTML = products.map(product => {
                        // --- FIX 3: Card layout updated to "Add to Cart" ---
                        const productId = product.id || product._id;
                        return `
                        <div class="bg-white rounded-lg shadow-md overflow-hidden transform hover:-translate-y-2 transition-all duration-300" data-aos="fade-up">
                            <div class="relative overflow-hidden group">
                                <img src="${product.imageUrl || '/images/placeholder.png'}" alt="${product.name}" class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500">
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                            </div>
                            <div class="p-6">
                                <h3 class="text-xl font-semibold mb-2">${product.name}</h3>
                                <p class="text-text-secondary text-sm mb-4">${product.description ? product.description.substring(0, 100) : ''}...</p>
                                <div class="flex flex-wrap items-center gap-2 justify-between">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="text-2xl font-bold text-accent-brown">₹${Number(product.price).toFixed(2)}</span>
                                        ${product.mrp && product.mrp > 0 && product.discount > 0 && product.mrp !== product.price ? `<span class="text-lg text-gray-500 line-through">₹${Number(product.mrp).toFixed(2)}</span>` : ''}
                                        ${product.discount > 0 ? `<span class="text-sm font-semibold text-green-600 bg-green-100 px-2 py-1 rounded">(${product.discount}% off)</span>` : ''}
                                    </div>
                                    <button onclick="addToCart('${productId}')" class="bg-gradient-to-r from-[#8C6A5D] to-[#73564B] text-white px-4 py-2 rounded-md hover:from-[#73564B] hover:to-[#8C6A5D] transition-colors">Add to Cart</button>
                                </div>
                            </div>
                        </div>
                    `}).join('');
                }
            } catch (error) {
                console.error('Error loading featured products:', error);
                // --- FIX 1 (continued): Reset flag on error so fallback can try again ---
                hasLoadedFeaturedProducts = false;
            }
        }

        // Initialize slider
        function initSlider() {
            const slides = document.querySelectorAll('.slider-slide');
            const dots = document.querySelectorAll('.slider-dot');
            let currentSlide = 0;

            function showSlide(n) {
                if (!slides[n] || !dots[n]) return; // Add guard clause
                slides.forEach(slide => slide.classList.remove('active'));
                dots.forEach(dot => dot.classList.remove('bg-white'));
                slides[n].classList.add('active');
                dots[n].classList.add('bg-white');
            }

            function nextSlide() {
                currentSlide = (currentSlide + 1) % slides.length;
                showSlide(currentSlide);
            }

            if (slides.length > 0) {
                setInterval(nextSlide, 5000);
                dots.forEach((dot, index) => {
                    dot.addEventListener('click', () => {
                        currentSlide = index;
                        showSlide(currentSlide);
                    });
                });
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            loadFeaturedProducts(); // Primary attempt
            initSlider();
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });

        // Fallback: if featured products didn't load
        // This will now only run if the first attempt failed and reset the flag
        setTimeout(() => {
            try {
                if (typeof loadFeaturedProducts === 'function') loadFeaturedProducts();
            } catch (err) {
                console.warn('Fallback loadFeaturedProducts failed:', err);
            }
        }, 300);
    </script>
</body>
</html>