<%- include('partials/header') -%>

    <!-- Main Content -->
    <main>
        <!-- Hero Section -->
        <section class="pt-24 lg:pt-40 bg-bg-card">
            <div class="relative container mx-auto overflow-hidden rounded-xl shadow-2xl h-[30vh] lg:h-[40vh] flex items-center justify-center text-center">
                <img src="/images/whyfrozen.png" class="absolute w-full h-full object-cover" alt="Fresh Frozen Vegetables Background" style="object-position: 50% 90%;">
                <div class="absolute inset-0 bg-black/40"></div>
                <div class="relative text-white p-8" data-aos="zoom-in">
                    <h1 class="font-serif text-4xl md:text-7xl font-bold">Why Choose Frozen Foods?</h1>
                    <p class="mt-4 text-lg md:text-xl max-w-2xl mx-auto">Smart. Fresh. Sustainable. Delicious.</p>
                </div>
            </div>
        </section>

        <!-- Intro Section -->
        <section class="py-16 lg:py-24">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="max-w-4xl mx-auto text-center">
                    <p class="text-lg text-text-secondary" data-aos="fade-up">
                        At <strong>Nanshhuf</strong>, we believe frozen food isn’t just about convenience—it’s about <strong>unlocking the best of nature and nutrition, at your fingertips.</strong> Gone are the days of myths around frozen meals; today, freezing is the secret to enjoying <strong>global flavors, peak freshness, and guilt-free convenience</strong> without compromise.
                    </p>
                </div>
            </div>
        </section>

        <!-- Benefits Grid Section -->
        <section class="py-16 lg:py-24 bg-bg-card border-y border-gray-200">
            <div class="container mx-auto px-4 lg:px-6">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                    <!-- Benefit Item -->
                    <div data-aos="fade-up" data-aos-delay="100">
                        <div class="flex items-center mb-4">
                            <i data-lucide="leaf" class="w-8 h-8 text-accent-brown"></i>
                            <h3 class="ml-4 font-serif text-2xl">Freshness, Locked at Its Peak</h3>
                        </div>
                        <p class="text-text-secondary">Our rapid-freezing technology ensures every ingredient—be it crisp vegetables, tender meats, or aromatic herbs—retains its vitamins, minerals, and authentic flavor. No preservatives. No shortcuts. Just nature, captured at its very best.</p>
                    </div>
                     <!-- Benefit Item -->
                    <div data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-center mb-4">
                            <i data-lucide="utensils-crossed" class="w-8 h-8 text-accent-brown"></i>
                            <h3 class="ml-4 font-serif text-2xl">Taste that Rivals Restaurants</h3>
                        </div>
                        <p class="text-text-secondary">Every bite is crafted to bring you the luxury of fine dining at home. With ingredients frozen at their freshest, our meals burst with authentic flavors that dance on your tongue—making you forget they ever came from the freezer.</p>
                    </div>
                    <!-- Benefit Item -->
                    <div data-aos="fade-up" data-aos-delay="300">
                         <div class="flex items-center mb-4">
                            <i data-lucide="zap" class="w-8 h-8 text-accent-brown"></i>
                            <h3 class="ml-4 font-serif text-2xl">Convenience without Compromise</h3>
                        </div>
                        <p class="text-text-secondary">Why spend hours chopping, prepping, and cooking? With Nanshhuf Frozen Delights, it’s simply: <strong>Heat. Eat. Savor.</strong> From quick solo meals to hearty family feasts, we’ve got the perfect portions to match your lifestyle—without food waste or fuss.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sustainability Section -->
        <section class="py-16 lg:py-24">
             <div class="container mx-auto px-4 lg:px-6">
                 <div class="flex flex-col lg:flex-row items-center gap-12">
                     <div class="lg:w-1/2" data-aos="fade-right">
                         <img src="https://placehold.co/600x400/F9F7F3/8C6A5D?text=Sustainable+Planet" alt="Illustration of a green planet" class="rounded-lg shadow-xl">
                     </div>
                     <div class="lg:w-1/2" data-aos="fade-left">
                         <h2 class="text-3xl md:text-5xl font-serif">Good for You, Good for the Planet</h2>
                         <ul class="mt-6 space-y-4">
                            <li class="flex items-start">
                                <i data-lucide="recycle" class="w-6 h-6 text-accent-brown mr-3 mt-1 flex-shrink-0"></i>
                                <div>
                                    <h4 class="font-semibold">Less Waste</h4>
                                    <p class="text-text-secondary">Longer shelf life means fewer trips to the store and less food thrown away.</p>
                                </div>
                            </li>
                             <li class="flex items-start">
                                <i data-lucide="sprout" class="w-6 h-6 text-accent-brown mr-3 mt-1 flex-shrink-0"></i>
                                <div>
                                    <h4 class="font-semibold">Responsible Sourcing</h4>
                                    <p class="text-text-secondary">Only the finest ingredients make it into our kitchen—and into yours.</p>
                                </div>
                            </li>
                              <li class="flex items-start">
                                <i data-lucide="globe" class="w-6 h-6 text-accent-brown mr-3 mt-1 flex-shrink-0"></i>
                                <div>
                                    <h4 class="font-semibold">Sustainable Practices</h4>
                                    <p class="text-text-secondary">By reducing spoilage and waste, frozen foods help you contribute to a healthier planet.</p>
                                </div>
                            </li>
                         </ul>
                     </div>
                 </div>
             </div>
        </section>

         <!-- CTA Section -->
        <section class="py-16 lg:py-24 bg-bg-card">
            <div class="container mx-auto px-4 lg:px-6 text-center">
                <div data-aos="fade-up">
                    <i data-lucide="sparkles" class="w-12 h-12 text-accent-brown mx-auto mb-4"></i>
                    <h2 class="font-serif text-2xl md:text-4xl text-accent-brown">The Nanshhuf Way</h2>
                    <p class="text-lg max-w-3xl mx-auto mt-4 text-text-secondary">Frozen isn’t just food—it’s a <strong>lifestyle upgrade</strong>. With us, you’re not just saving time; you’re choosing <strong>flavor, nutrition, and responsibility</strong> in every bite.</p>
                    <p class="mt-8 font-semibold text-lg">👉 It’s time to rethink frozen food. With Nanshhuf, it’s fresh, it’s global, it’s effortless.</p>
                </div>
            </div>
        </section>
    </main>

<%- include('partials/footer') -%>
<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
